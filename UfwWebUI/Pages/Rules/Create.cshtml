@page
@model UfwWebUI.Pages.Rules.CreateModel
@{
    ViewData["Title"] = "Create Rule";
}

<h1>Create Rule</h1>

<h4>UFW Rule</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="UfwRule.Type" class="control-label"></label>
                <select asp-for="UfwRule.Type" class="form-control" asp-items="Html.GetEnumSelectList<UfwWebUI.Models.RuleType>()"></select>
                <span asp-validation-for="UfwRule.Type" class="text-danger"></span>
            </div>
            
            <div class="form-group form-check mb-3">
                <input class="form-check-input" asp-for="UfwRule.Forward" />
                <label class="form-check-label" asp-for="UfwRule.Forward"></label>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.SourceIp" class="control-label"></label>
                        <input asp-for="UfwRule.SourceIp" class="form-control" placeholder="e.g., 192.168.1.100" />
                        <span asp-validation-for="UfwRule.SourceIp" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.SourceSubnet" class="control-label"></label>
                        <input asp-for="UfwRule.SourceSubnet" class="form-control" placeholder="e.g., 24" />
                        <span asp-validation-for="UfwRule.SourceSubnet" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.TargetIp" class="control-label"></label>
                        <input asp-for="UfwRule.TargetIp" class="form-control" placeholder="e.g., 10.0.0.1" />
                        <span asp-validation-for="UfwRule.TargetIp" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.TargetSubnet" class="control-label"></label>
                        <input asp-for="UfwRule.TargetSubnet" class="form-control" placeholder="e.g., 16" />
                        <span asp-validation-for="UfwRule.TargetSubnet" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="UfwRule.Protocol" class="control-label"></label>
                <select asp-for="UfwRule.Protocol" class="form-control" asp-items="Html.GetEnumSelectList<UfwWebUI.Models.Protocol>()">
                    <option value="">-- Select Protocol (Optional) --</option>
                </select>
                <span asp-validation-for="UfwRule.Protocol" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.PortRangeStart" class="control-label"></label>
                        <input asp-for="UfwRule.PortRangeStart" class="form-control" type="number" min="0" max="65535" />
                        <span asp-validation-for="UfwRule.PortRangeStart" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UfwRule.PortRangeEnd" class="control-label"></label>
                        <input asp-for="UfwRule.PortRangeEnd" class="form-control" type="number" min="0" max="65535" />
                        <span asp-validation-for="UfwRule.PortRangeEnd" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="UfwRule.Comment" class="control-label"></label>
                <textarea asp-for="UfwRule.Comment" class="form-control" rows="3"></textarea>
                <span asp-validation-for="UfwRule.Comment" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
