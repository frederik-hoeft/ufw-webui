# Copy to deploy/docker/.env and chmod 0600 before editing.

# Independently built runtime images. Keeping the frontend in its own nginx
# image is a security boundary: ASP cannot modify browser-delivered signing code.
UFW_FRONTEND_IMAGE=ufw-webui-frontend:local
UFW_ASP_IMAGE=ufw-webui-asp:local

# nginx TLS listener. 8443 works without privileged-port host configuration in
# rootless Docker. See the runbook before changing this to 443.
UFW_HTTPS_BIND_ADDRESS=0.0.0.0
UFW_HTTPS_PORT=8443

# Directory mounted read-only into nginx. It must contain tls.crt and tls.key.
# The key must be readable by the nginx supplemental group configured below,
# but the directory is never mounted into ASP.
UFW_TLS_HOST_DIR=/home/CHANGE_ME/ufw-webui/tls
# Rootless Docker: keep 0 when the TLS files are owned by the Docker user's
# primary host group. Rootful Docker: use the numeric host GID owning the key.
UFW_TLS_CONTAINER_GID=0

# Host daemon socket directory. The systemd installer creates this at runtime.
UFW_IPC_HOST_DIR=/run/ufw-manager

# Rootless Docker: keep 0. Container GID 0 maps to the rootless Docker user's
# primary host GID. Rootful Docker: set this to `getent group <ipc-group> | cut -d: -f3`.
UFW_IPC_CONTAINER_GID=0

# P-256 PKCS#8 PEM key mounted only into ASP. Rootless Docker: keep GID 0
# when the key is owned by the Docker user's primary host group. Rootful Docker:
# use a dedicated host group such as ufw-webui-jwt rather than reusing the IPC group.
UFW_WEB_JWT_KEY_PATH=/home/CHANGE_ME/ufw-webui/secrets/jwt-signing-key.pem
UFW_JWT_CONTAINER_GID=0
UFW_JWT_ISSUER=ufw-webui
UFW_JWT_AUDIENCE=ufw-webui-client

# Initial account. Password is creation-only and may be emptied after the first
# successful bootstrap; existing passwords are never reset from configuration.
UFW_BOOTSTRAP_EMAIL=admin@example.invalid
UFW_BOOTSTRAP_USERNAME=admin
UFW_BOOTSTRAP_PASSWORD=CHANGE_ME

POSTGRES_DB=ufw_webui
POSTGRES_USER=ufw_webui
POSTGRES_PASSWORD=CHANGE_ME

# Docker-managed named volume by default. A rootless bind mount can be used
# instead after preparing its ownership as described in the deployment runbook.
POSTGRES_DATA_SOURCE=postgres-data
