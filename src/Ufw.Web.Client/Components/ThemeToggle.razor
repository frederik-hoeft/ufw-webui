@inject IClientThemeService Theme
@inject IStringLocalizer<CommonStrings> CommonText

@if (ShowLabel)
{
    <MudButton Variant="@Variant"
               Color="@Color"
               StartIcon="@Icon"
               Disabled="@_busy"
               OnClick="ToggleAsync"
               Class="@Class"
               title="@Label"
               aria-label="@Label"
               aria-pressed="@Theme.IsDarkMode.ToString().ToLowerInvariant()">
        @CommonText["Theme"]
    </MudButton>
}
else
{
    <MudIconButton Icon="@Icon"
                   Color="@Color"
                   Variant="@Variant"
                   Disabled="@_busy"
                   OnClick="ToggleAsync"
                   Class="@Class"
                   title="@Label"
                   aria-label="@Label"
                   aria-pressed="@Theme.IsDarkMode.ToString().ToLowerInvariant()" />
}
