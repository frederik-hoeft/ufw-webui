@using System.Linq.Expressions
@inject IKnownHostSuggestionService HostSuggestions
@inject IStringLocalizer<RulesStrings> RulesText

<MudAutocomplete T="string"
                 Label="@Label"
                 Value="@_state.DisplayValue"
                 ValueChanged="ValueChangedAsync"
                 For="@For"
                 SearchFunc="SearchAsync"
                 CoerceValue="true"
                 Immediate="true"
                 ResetValueOnEmptyText="true"
                 Disabled="@Disabled"
                 MaxItems="@((int?)null)"
                 Placeholder="@Placeholder"
                 PopoverClass="known-host-popover"
                 autocomplete="off"
                 autocapitalize="off"
                 spellcheck="false">
    <ItemTemplate Context="selectionValue">
        @if (FindSuggestion(selectionValue) is { } host)
        {
            <div class="known-host-option">
                <div>
                    <strong>@host.Name</strong>
                    <code>@host.Address</code>
                </div>
                @if (!string.IsNullOrWhiteSpace(host.Comment))
                {
                    <small>@host.Comment</small>
                }
            </div>
        }
        else
        {
            <span>@selectionValue</span>
        }
    </ItemTemplate>
    <NoItemsTemplate>
        <div class="known-host-no-items">
            @RulesText["NoKnownHostMatches"]
        </div>
    </NoItemsTemplate>
</MudAutocomplete>
