@using Ufw.Shared.Ipc.Model.Responses.Domain
@using Ufw.Web.Client.UI.Components.Rules.Metadata
@page "/rules/create"
@attribute [Authorize]
@implements IDisposable
@inject IRuleApiClient RuleApiClient
@inject IRuleMutationService RuleMutations
@inject IRuleInsertionNavigationService InsertionNavigation
@inject IRuleMutationReconciliationService MutationReconciliation
@inject IRuleDraftFactory RuleDraftFactory
@inject IRuleTemplateCatalogService TemplateCatalog
@inject IRuleTemplateAuthoringService TemplateAuthoring
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IFirewallRuleText RuleText
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText
@inject IStringLocalizer<TemplatesStrings> TemplatesText

<PageTitle>@RulesText["CreatePageTitle"] - UFWeb</PageTitle>

<div class="rule-create-page">
<PageHeader Title="@(RulesText["CreateTitle"])"
            Description="@HeaderDescription"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="false">
    <Actions>
        <MudButton Href="/rules"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Disabled="@_submitting"
                   Class="page-header-button">
            @RulesText["BackToRules"]
        </MudButton>
    </Actions>
</PageHeader>

@if (_state.Status == RuleInventoryStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_state.Error?.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_submitting"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}
else if (_state.Snapshot is null)
{
    <MudPaper Class="pa-5" Elevation="1" role="status" aria-live="polite">
        <MudProgressLinear Indeterminate="true" Class="mb-3" aria-label="@(RulesText["LoadingStateAria"])" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @RulesText["LoadingBeforeCreate"]
        </MudText>
    </MudPaper>
}
else
{
    @if (_state.IsStale)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["StaleTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeStaleState()</MudText>
            @if (_state.Error is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_state.Error.Message</MudText>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_submitting"
                       OnClick="RefreshAsync">
                @RulesText["RefreshAuthoritative"]
            </MudButton>
        </MudAlert>
    }
    else if (_state.Status == RuleInventoryStatus.Refreshing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">
                @(_mutationMayHaveCompleted
                    ? RulesText["RuleSubmissionConfirming"]
                    : RulesText["RefreshingAuthoritative"])
            </MudText>
        </MudAlert>
    }

    @if (IsOrderedInsertionRequested)
    {
        <MudAlert Severity="@(_orderedInsertionContext is null ? Severity.Warning : Severity.Info)"
                  Variant="Variant.Outlined"
                  Class="mb-5"
                  role="note">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["OrderedInsertionTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeInsertionTarget()</MudText>
            @if (_orderedInsertionContext is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-2">@DescribeInsertionFamily()</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@RulesText["OrderedInsertionDescription"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-3">@RulesText["OrderedInsertionReselect"]</MudText>
            }
            <MudButton Href="/rules" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mr-2">
                @RulesText["BackToRules"]
            </MudButton>
            <MudButton Href="/rules/create" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">
                @RulesText["CreateAtEndInstead"]
            </MudButton>
        </MudAlert>
    }

    @if (_insertionResult is { } insertionResult && insertionResult.Outcome != RuleInsertionOutcome.Completed)
    {
        <MudAlert Severity="@InsertionResultSeverity" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@DescribeInsertionResultTitle()</MudText>
            @if (!string.IsNullOrWhiteSpace(insertionResult.Diagnostic))
            {
                <MudText Typo="Typo.body2" Class="mb-2">@insertionResult.Diagnostic</MudText>
            }
            @if (_orderedInsertionInvalidated)
            {
                <MudText Typo="Typo.body2">@RulesText["OrderedInsertionReselect"]</MudText>
            }
        </MudAlert>
    }

    <MudPaper Class="pa-5 mb-5" Elevation="1">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@TemplatesText["LoadTemplateTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@TemplatesText["LoadTemplateDescription"]</MudText>

        @if (_templateCatalogError is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" role="status">
                <MudText Typo="Typo.body2" Class="mb-2">@TemplatesText["TemplateLoadFailed"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@_templateCatalogError.Message</MudText>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(_loadingTemplates || _submitting)" OnClick="ReloadTemplatesAsync">
                    @TemplatesText["ReloadTemplates"]
                </MudButton>
            </MudAlert>
        }
        else if (_loadingTemplates)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-4" />
        }
        else if (_templates.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@TemplatesText["NoTemplates"]</MudText>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="Guid?" Label="@(TemplatesText["SelectTemplate"])" @bind-Value="_selectedTemplateId" Disabled="@(!CanEdit)" Clearable="true">
                        @foreach (RuleTemplate template in _templates)
                        {
                            <MudSelectItem T="Guid?" Value="@((Guid?)template.Id)">@DescribeTemplateOption(template)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6" Class="rule-template-loader-action">
                    <MudButton Variant="Variant.Outlined"
                               Class="rule-template-load-button"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(!CanLoadSelectedTemplate)"
                               OnClick="LoadSelectedTemplate">
                        @TemplatesText["LoadTemplate"]
                    </MudButton>
                </MudItem>
            </MudGrid>
        }

        @if (!string.IsNullOrWhiteSpace(_templateContextWarning))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4" role="status">@_templateContextWarning</MudAlert>
        }
        else if (_loadedTemplateId is { } loadedTemplateId && FindTemplate(loadedTemplateId) is { } loadedTemplate)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4" role="status">@TemplatesText["TemplateLoaded", loadedTemplate.Name]</MudAlert>
        }
    </MudPaper>

    <RuleEditor @key="_draft"
                Rule="@_draft"
                DefinitionDescription="@RuleDefinitionDescription"
                Disabled="@(!CanEdit)"
                AddressFamilyLocked="@IsOrderedInsertionRequested"
                IPv6Enabled="@_state.Snapshot.Configuration.IPv6Enabled"
                SubmitDisabled="@(!CanSubmit)"
                SubmitLabel="@(IsOrderedInsertionRequested ? RulesText["InsertSignedRule"] : RulesText["AddSignedRule"])"
                SubmittingLabel="@(IsOrderedInsertionRequested ? RulesText["InsertingRule"] : RulesText["AddingRule"])"
                Submitting="@_submitting"
                @bind-PrivateKey="_privateKey"
                OnSubmit="SubmitRuleAsync"
                OnCancel="Cancel" />

    <MudPaper Class="rule-create-metadata pa-5 mt-5" Elevation="1">
        <MudText Typo="Typo.h6" GutterBottom="true">@RulesText["RuleMetadata"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @RulesText["CreateRuleMetadataDescription"]
        </MudText>
        <RuleMetadataEditor @ref="_metadataEditor"
                            Value="@_metadataDraft"
                            ValueChanged="MetadataChanged"
                            Disabled="@(!CanEdit)" />
    </MudPaper>
}
</div>
