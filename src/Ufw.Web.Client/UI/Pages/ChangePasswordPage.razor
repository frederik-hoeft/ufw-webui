@page "/settings/password"
@attribute [Authorize]
@implements IDisposable
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<SettingsStrings> SettingsText

<PageTitle>@SettingsText["ChangePasswordPageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(SettingsText["ChangePasswordTitle"])"
            Description="@(SettingsText["ChangePasswordDescription"])"
            Breadcrumbs="@Breadcrumbs" />

<div class="change-password-page">
    <SettingsSection Title="@(SettingsText["AccountTitle"])"
                     Description="@(SettingsText["PasswordSessionNotice"])">
        <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="ChangePasswordAsync" aria-busy="@_busy">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">
                    @_error
                </MudAlert>
            }

            <MudTextField T="string"
                          Label="@(SettingsText["CurrentPassword"])"
                          InputType="InputType.Password"
                          @bind-Value="_currentPassword"
                          Required="true"
                          RequiredError="@(SettingsText["CurrentPasswordRequired"])"
                          autocomplete="current-password"
                          autocapitalize="off"
                          spellcheck="false"
                          Disabled="@_busy"
                          Immediate="true" />

            <MudTextField T="string"
                          Label="@(SettingsText["NewPassword"])"
                          InputType="InputType.Password"
                          @bind-Value="_newPassword"
                          Required="true"
                          RequiredError="@(SettingsText["NewPasswordRequired"])"
                          autocomplete="new-password"
                          autocapitalize="off"
                          spellcheck="false"
                          Disabled="@_busy"
                          Immediate="true" />

            <MudTextField T="string"
                          Label="@(SettingsText["ConfirmNewPassword"])"
                          InputType="InputType.Password"
                          @bind-Value="_confirmPassword"
                          Required="true"
                          RequiredError="@(SettingsText["ConfirmPasswordRequired"])"
                          Validation="@ValidateConfirmation"
                          autocomplete="new-password"
                          autocapitalize="off"
                          spellcheck="false"
                          Disabled="@_busy"
                          Immediate="true" />

            <div class="change-password-actions">
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           Href="/settings"
                           Disabled="@_busy">
                    @CommonText["Cancel"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Password"
                           Disabled="@(_busy || !_isValid)"
                           OnClick="ChangePasswordAsync">
                    @if (_busy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    @(_busy ? SettingsText["ChangingPassword"] : SettingsText["SavePassword"])
                </MudButton>
            </div>
        </MudForm>
    </SettingsSection>
</div>
