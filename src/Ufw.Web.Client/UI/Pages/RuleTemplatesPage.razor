@page "/templates"
@attribute [Authorize]
@implements IDisposable
@using Ufw.Web.Client.Features.Rules.Metadata
@using Ufw.Web.Client.UI.Components.Rules.Metadata
@using Ufw.Web.Client.UI.Components.Rules.Templates
@inject IRuleTemplateCatalogService TemplateCatalog
@inject IUfwRuleCommandRenderer RuleRenderer
@inject NavigationManager Navigation
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<TemplatesStrings> TemplatesText

<PageTitle>@TemplatesText["PageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(TemplatesText["Title"])"
            Description="@(TemplatesText["Description"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_loaded)">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @CommonText["Refresh"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@IsBusy"
                   OnClick="Create"
                   Class="page-header-button">
            @TemplatesText["AddTemplate"]
        </MudButton>
    </Actions>
    <Status>
        @if (_loaded)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeTemplateCount(_templates.Count)
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@(_mutationError ? TemplatesText["OperationFailed"] : TemplatesText["LoadFailed"])</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_error.Message</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@IsBusy" OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}

<MudPaper Class="inventory-card rule-template-inventory" Elevation="1">
    <header>
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@TemplatesText["InventoryTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@TemplatesText["InventoryDescription"]</MudText>
        </div>
    </header>

    @if (!_loaded)
    {
        @if (_error is null)
        {
            <div class="inventory-empty" role="status">
                <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
            </div>
        }
    }
    else if (_templates.Count == 0)
    {
        <div class="inventory-empty">
            <MudIcon Icon="@Icons.Material.Filled.Bookmarks" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body1">@TemplatesText["NoTemplates"]</MudText>
        </div>
    }
    else
    {
        <div class="inventory-desktop rule-template-desktop-list" role="region" aria-label="@(TemplatesText["InventoryTitle"])" aria-busy="@_loading">
            <table>
                <thead>
                    <tr>
                        <th scope="col" class="name">@TemplatesText["NameColumn"]</th>
                        <th scope="col" class="rule">@TemplatesText["RuleColumn"]</th>
                        <th scope="col" class="metadata">@TemplatesText["MetadataColumn"]</th>
                        <th scope="col" class="actions"><span class="visually-hidden">@TemplatesText["ActionsColumn"]</span></th>
                    </tr>
                </thead>
                @foreach (RuleTemplate template in _templates)
                {
                    bool expanded = IsExpanded(template.Id);
                    <tbody class="@(expanded ? "rule-template-row-group expanded" : "rule-template-row-group")" @key="template.Id">
                        <tr class="rule-template-row"
                            tabindex="0"
                            aria-expanded="@expanded"
                            @onclick="@(() => ToggleExpanded(template.Id))"
                            @onkeydown="@(args => HandleKeyDown(args, template.Id))">
                            <td class="name">
                                <div class="rule-template-name-stack">
                                    <strong>@template.Name</strong>
                                    <span class="rule-template-description">@(template.Description ?? TemplatesText["NoDescription"])</span>
                                </div>
                            </td>
                            <td class="rule"><code class="rule-template-command">@DescribeRule(template)</code></td>
                            <td class="metadata">@DescribeMetadata(template)</td>
                            <td class="actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                               Size="Size.Small"
                                               Disabled="@IsBusy"
                                               OnClick="@(() => ToggleExpanded(template.Id))"
                                               aria-label="@(expanded ? TemplatesText["HideTemplateDetails", template.Name] : TemplatesText["ShowTemplateDetails", template.Name])"
                                               aria-expanded="@expanded" />
                                <RuleTemplateActionsMenu Template="@template" Disabled="@IsBusy" UseRequested="Use" EditRequested="Edit" DeleteRequested="DeleteAsync" />
                            </td>
                        </tr>
                        @if (expanded)
                        {
                            <tr class="rule-template-details-row">
                                <td colspan="4">
                                    <RuleTemplateDetails Template="@template" CanonicalCommand="@DescribeRule(template)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>

        <div class="inventory-mobile rule-template-mobile-list" aria-busy="@_loading">
            @foreach (RuleTemplate template in _templates)
            {
                bool expanded = IsExpanded(template.Id);
                <article class="@(expanded ? "rule-template-mobile-card expanded" : "rule-template-mobile-card")" @key="template.Id">
                    <header tabindex="0"
                            aria-expanded="@expanded"
                            @onclick="@(() => ToggleExpanded(template.Id))"
                            @onkeydown="@(args => HandleKeyDown(args, template.Id))">
                        <div class="rule-template-name-stack">
                            <strong>@template.Name</strong>
                            <span class="rule-template-description">@(template.Description ?? TemplatesText["NoDescription"])</span>
                        </div>
                        <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => ToggleExpanded(template.Id))"
                                           aria-label="@(expanded ? TemplatesText["HideTemplateDetails", template.Name] : TemplatesText["ShowTemplateDetails", template.Name])"
                                           aria-expanded="@expanded" />
                            <RuleTemplateActionsMenu Template="@template" Disabled="@IsBusy" UseRequested="Use" EditRequested="Edit" DeleteRequested="DeleteAsync" />
                        </div>
                    </header>
                    <code class="rule-template-command">@DescribeRule(template)</code>
                    <span class="rule-template-metadata-summary">@DescribeMetadata(template)</span>
                    @if (expanded)
                    {
                        <RuleTemplateDetails Template="@template" CanonicalCommand="@DescribeRule(template)" />
                    }
                </article>
            }
        </div>
    }
</MudPaper>
