@using Ufw.Web.Client.Features.Rules.Metadata
﻿@using Ufw.Web.Client.UI.Components.Rules.Metadata
@page "/rules/edit"
@attribute [Authorize]
@implements IDisposable
@inject IRuleInventoryService RuleInventory
@inject IRuleMetadataMutationService MetadataMutations
@inject IRuleMutationService RuleMutations
@inject IRuleReplacementNavigationService ReplacementNavigation
@inject IRuleDraftFactory RuleDraftFactory
@inject NavigationManager Navigation
@inject TimeProvider TimeProvider
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<PageTitle>@RulesText["EditRulePageTitle"] - UFWeb</PageTitle>

<div class="rule-edit-page">
<PageHeader Title="@(RulesText["EditRuleTitle"])"
            Description="@(RulesText["EditRuleDescription"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_state.Snapshot is not null)">
    <Actions>
        <MudButton Href="/rules"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Disabled="@(_submitting || _metadataSaving)"
                   Class="page-header-button">
            @RulesText["BackToRules"]
        </MudButton>
    </Actions>
    <Status>
        @if (_state.Snapshot is { } snapshot)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(snapshot.FirewallActive ? "page-status-chip page-status-chip-success" : "page-status-chip page-status-chip-warning")">
                @(snapshot.FirewallActive ? RulesText["FirewallActive"] : RulesText["FirewallInactive"])
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeRuleCount(snapshot.Rules.Count)
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(snapshot.Configuration.IPv6Enabled ? "page-status-chip page-status-chip-success" : "page-status-chip page-status-chip-warning")">
                @(snapshot.Configuration.IPv6Enabled ? RulesText["IPv6CapabilityEnabled"] : RulesText["IPv6CapabilityDisabled"])
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(_state.IsStale ? "page-status-chip page-status-chip-warning" : "page-status-chip")">
                @DescribeSnapshotStatus()
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_state.Status == RuleInventoryStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_state.Error?.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@(_submitting || _metadataSaving)"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}
else if (_state.Snapshot is null)
{
    <MudPaper Class="pa-5" Elevation="1" role="status" aria-live="polite">
        <MudProgressLinear Indeterminate="true" Class="mb-3" aria-label="@(RulesText["LoadingStateAria"])" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @RulesText["LoadingBeforeEdit"]
        </MudText>
    </MudPaper>
}
else
{
    @if (_state.IsStale)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["StaleTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeStaleState()</MudText>
            @if (_state.Error is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_state.Error.Message</MudText>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(_submitting || _metadataSaving || FirewallReplacementCompleted)"
                       OnClick="RefreshAsync">
                @RulesText["RefreshAuthoritative"]
            </MudButton>
        </MudAlert>
    }
    else if (_state.Status == RuleInventoryStatus.Refreshing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">@RulesText["RefreshingAuthoritative"]</MudText>
        </MudAlert>
    }

    <MudAlert Severity="@ReplacementTargetSeverity"
              Variant="Variant.Outlined"
              Class="mb-5"
              role="note">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["EditingRuleTarget"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">@DescribeReplacementTarget()</MudText>
        @if (_replacementContext is not null && !_workflow.ContextInvalidated)
        {
            <MudText Typo="Typo.body2">@RulesText["ReplacementTargetLocked"]</MudText>
        }
        else if (FirewallReplacementCompleted)
        {
            <MudText Typo="Typo.body2">@RulesText["ReplacementContextConsumed"]</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-3">@RulesText["ReplacementContextReselect"]</MudText>
            <MudButton Href="/rules" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">
                @RulesText["BackToRules"]
            </MudButton>
        }
    </MudAlert>

    @if (_workflow.Replacement is { Firewall.Outcome: not RuleReplacementOutcome.Completed } replacementResult)
    {
        <MudAlert Severity="@ReplacementResultSeverity" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@DescribeReplacementResultTitle()</MudText>
            @if (!string.IsNullOrWhiteSpace(replacementResult.Firewall.Diagnostic))
            {
                <MudText Typo="Typo.body2" Class="mb-2">@replacementResult.Firewall.Diagnostic</MudText>
            }
            @if (DescribeRecoveryOutcome() is { } recoveryDescription)
            {
                <MudText Typo="Typo.body2" Class="mb-2">@recoveryDescription</MudText>
            }
            <MudText Typo="Typo.body2">@RulesText["ReplacementContextReselect"]</MudText>
        </MudAlert>
    }

    @if (_workflow.Replacement is { Firewall.Outcome: RuleReplacementOutcome.Completed, MetadataReconciliation: RuleReplacementMetadataReconciliationOutcome.Failed } completedWithMetadataFailure)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert" aria-live="assertive">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["ReplacementMetadataReconciliationFailed"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@RulesText["ReplacementFirewallSucceeded"]</MudText>
            @if (!string.IsNullOrWhiteSpace(completedWithMetadataFailure.MetadataDiagnostic))
            {
                <MudText Typo="Typo.body2" Class="mb-3">@completedWithMetadataFailure.MetadataDiagnostic</MudText>
            }
            <MudButton Href="/rules" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
                @RulesText["BackToRules"]
            </MudButton>
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_workflow.MetadataSaveDiagnostic))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["MetadataSaveAfterReplacementFailed"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@RulesText["ReplacementFirewallSucceeded"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@_workflow.MetadataSaveDiagnostic</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@(!CanRetryMetadataSave)"
                       OnClick="RetryMetadataSaveAsync"
                       Class="mr-2">
                @(_metadataSaving ? RulesText["SavingMetadata"] : RulesText["RetryMetadataSave"])
            </MudButton>
            <MudButton Href="/rules" Variant="Variant.Text" Disabled="@_metadataSaving">
                @RulesText["BackToRules"]
            </MudButton>
        </MudAlert>
    }

    @if (HasAuthoringState)
    {
        <RuleEditor @key="_draft"
                    Rule="@Draft"
                    OriginalRule="@OriginalRule"
                    Mode="RuleEditorMode.Edit"
                    Disabled="@(!CanEdit)"
                    IPv6Enabled="@_state.Snapshot.Configuration.IPv6Enabled"
                    SubmitDisabled="@(!CanSubmit)"
                    Submitting="@_submitting"
                    @bind-PrivateKey="_privateKey"
                    OnSubmit="SubmitRuleAsync"
                    OnCancel="Cancel" />

        <MudPaper Class="rule-create-metadata pa-5 mt-5" Elevation="1">
            <MudText Typo="Typo.h6" GutterBottom="true">@RulesText["RuleMetadata"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @RulesText["EditRuleMetadataDescription"]
            </MudText>
            <RuleMetadataEditor @ref="_metadataEditor"
                                Value="@_metadataDraft"
                                ValueChanged="MetadataChanged"
                                Disabled="@(!CanEdit)" />
        </MudPaper>
    }
}
</div>
