@page "/metadata"
@attribute [Authorize]
@using Ufw.Web.Client.UI.Components.Rules.Metadata
@inject IDialogService DialogService
@inject IStringLocalizer<RulesStrings> RulesText

<PageTitle>@RulesText["MetadataManagementPageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(RulesText["MetadataManagementTitle"])"
            Description="@(RulesText["MetadataManagementDescription"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="false" />

<div class="rule-metadata-management">
    <MudPaper Elevation="1" Class="card">
        <div>
            <MudIcon Icon="@Icons.Material.Outlined.Label" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@RulesText["ManageTags"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["ManageTagsDescription"]</MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Label"
                   Disabled="@_dialogOpen"
                   OnClick="ManageTagsAsync">
            @RulesText["Manage"]
        </MudButton>
    </MudPaper>

    <MudPaper Elevation="1" Class="card">
        <div>
            <MudIcon Icon="@Icons.Material.Filled.Rule" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" HtmlTag="h2">@RulesText["ReconcileMetadata"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["ReconcileMetadataDescription"]</MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Rule"
                   Disabled="@_dialogOpen"
                   OnClick="ReconcileMetadataAsync">
            @RulesText["Reconcile"]
        </MudButton>
    </MudPaper>
</div>
