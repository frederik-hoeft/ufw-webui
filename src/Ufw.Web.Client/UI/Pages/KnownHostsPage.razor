@page "/hosts"
@attribute [Authorize]
@implements IDisposable
@inject IKnownHostInventoryService HostInventory
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<KnownHostsStrings> HostsText

<PageTitle>@HostsText["PageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(HostsText["Title"])"
            Description="@(HostsText["Description"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_inventory is not null)">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @CommonText["Refresh"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@IsBusy"
                   OnClick="CreateAsync"
                   Class="page-header-button">
            @HostsText["AddHost"]
        </MudButton>
    </Actions>
    <Status>
        @if (_inventory is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeCount(_inventory.Hosts.Count)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeVisibleCount(_inventory.Hosts.Count(static host => host.IsVisible))
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@HostsText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_error.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}

<MudPaper Class="inventory-card known-host-inventory" Elevation="1">
    <header>
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@HostsText["InventoryTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @HostsText["InventoryDescription"]
            </MudText>
        </div>
    </header>

    @if (_loading && _inventory is null)
    {
        <div class="inventory-loading" role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" aria-label="@(HostsText["LoadingAria"])" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@HostsText["LoadingInventory"]</MudText>
        </div>
    }
    else if (_inventory is { Hosts.Count: 0 })
    {
        <div class="inventory-empty">
            <MudIcon Icon="@Icons.Material.Filled.Devices" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1">@HostsText["NoKnownHosts"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @HostsText["NoKnownHostsDescription"]
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@IsBusy"
                       OnClick="CreateAsync">
                @HostsText["AddHost"]
            </MudButton>
        </div>
    }
    else if (_inventory is not null)
    {
        <MudTable T="KnownHostInventoryItem"
                  Items="@_inventory.Hosts"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Class="inventory-desktop">
            <HeaderContent>
                <MudTh Class="known-host-visibility-column">@HostsText["VisibilityColumn"]</MudTh>
                <MudTh>@HostsText["NameColumn"]</MudTh>
                <MudTh>@HostsText["AddressColumn"]</MudTh>
                <MudTh>@HostsText["CommentColumn"]</MudTh>
                <MudTh Class="known-host-actions-column">@HostsText["ActionsColumn"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@(HostsText["VisibilityColumn"])" Class="known-host-visibility-column">
                    <div>
                        <MudTooltip Text="@VisibilityActionText(context)">
                            <MudIconButton Icon="@(context.IsVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           Color="@(context.IsVisible ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => UpdateVisibilityAsync(context, !context.IsVisible))"
                                           aria-label="@VisibilityActionText(context)" />
                        </MudTooltip>
                    </div>
                </MudTd>
                <MudTd DataLabel="@(HostsText["NameColumn"])">
                    <div class="known-host-name">
                        <strong>@context.Name</strong>
                        @if (context.AddressSource == KnownHostAddressSource.Dns)
                        {
                            <MudTooltip Text="@(HostsText["DnsBackedAlias"])">
                                <span class="known-host-dns-indicator"><MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" /> DNS</span>
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="@(HostsText["AddressColumn"])">
                    <div class="known-host-address-stack">
                        <code class="known-host-address">@context.Address</code>
                        @if (context.DnsResolvedAt is { } resolvedAt)
                        {
                            <span>@DescribeDnsResolvedAt(resolvedAt)</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="@(HostsText["CommentColumn"])">
                    <span class="@(string.IsNullOrWhiteSpace(context.Comment) ? "known-host-comment-empty" : "known-host-comment")">
                        @(string.IsNullOrWhiteSpace(context.Comment) ? HostsText["NoComment"] : context.Comment)
                    </span>
                </MudTd>
                <MudTd DataLabel="@(HostsText["ActionsColumn"])" Class="known-host-actions-column">
                    <div>
                        @if (context.AddressSource == KnownHostAddressSource.Dns)
                        {
                            <MudTooltip Text="@(HostsText["ReconcileDns"])">
                                <MudIconButton Icon="@Icons.Material.Filled.Sync"
                                               Size="Size.Small"
                                               Disabled="@IsBusy"
                                               OnClick="@(() => ReconcileDnsAsync(context))"
                                               aria-label="@(HostsText["ReconcileDnsAria", context.Name])" />
                            </MudTooltip>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => EditAsync(context))">
                            @HostsText["EditHost"]
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteAsync(context))">
                            @HostsText["DeleteHost"]
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="inventory-mobile">
            @foreach (KnownHostInventoryItem host in _inventory.Hosts)
            {
                <article>
                    <div class="inventory-mobile-visibility">
                        <MudTooltip Text="@VisibilityActionText(host)">
                            <MudIconButton Icon="@(host.IsVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           Color="@(host.IsVisible ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => UpdateVisibilityAsync(host, !host.IsVisible))"
                                           aria-label="@VisibilityActionText(host)" />
                        </MudTooltip>
                    </div>
                    <div class="inventory-mobile-copy">
                        <div class="known-host-name">
                            <strong>@host.Name</strong>
                            @if (host.AddressSource == KnownHostAddressSource.Dns)
                            {
                                <span class="known-host-dns-indicator"><MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" /> DNS</span>
                            }
                        </div>
                        <div class="known-host-address-stack">
                            <code class="known-host-address">@host.Address</code>
                            @if (host.DnsResolvedAt is { } resolvedAt)
                            {
                                <span>@DescribeDnsResolvedAt(resolvedAt)</span>
                            }
                        </div>
                        <span class="@(string.IsNullOrWhiteSpace(host.Comment) ? "known-host-comment-empty" : "known-host-comment")">
                            @(string.IsNullOrWhiteSpace(host.Comment) ? HostsText["NoComment"] : host.Comment)
                        </span>
                    </div>
                    <div class="inventory-mobile-actions">
                        @if (host.AddressSource == KnownHostAddressSource.Dns)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Sync"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => ReconcileDnsAsync(host))"
                                           aria-label="@(HostsText["ReconcileDnsAria", host.Name])" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Disabled="@IsBusy"
                                       OnClick="@(() => EditAsync(host))"
                                       aria-label="@(HostsText["EditHostAria", host.Name])" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="@IsBusy"
                                       OnClick="@(() => DeleteAsync(host))"
                                       aria-label="@(HostsText["DeleteHostAria", host.Name])" />
                    </div>
                </article>
            }
        </div>
    }
</MudPaper>
