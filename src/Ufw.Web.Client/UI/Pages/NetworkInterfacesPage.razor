@page "/interfaces"
@attribute [Authorize]
@implements IDisposable
@inject INetworkInterfaceInventoryService InterfaceInventory
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<InterfacesStrings> InterfacesText

<PageTitle>@InterfacesText["PageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(InterfacesText["Title"])"
            Description="@(InterfacesText["Description"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_inventory is not null)">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @InterfacesText["RefreshCacheView"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@IsBusy"
                   OnClick="ReconcileAsync"
                   Class="page-header-button">
            @InterfacesText["ReconcileFromDaemon"]
        </MudButton>
    </Actions>
    <Status>
        @if (_inventory is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeCount(_inventory.Interfaces.Count)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeVisibleCount(_inventory.Interfaces.Count(static item => item.IsVisible))
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @(_inventory.ReconciledAt is { } reconciledAt
                    ? InterfacesText["ReconciledAt", FormatLocalDateTime(reconciledAt)]
                    : InterfacesText["NotReconciledYet"])
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@InterfacesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_error.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}

<MudPaper Class="inventory-card interface-inventory" Elevation="1">
    <header>
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@InterfacesText["CachedInventoryTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @InterfacesText["CachedInventoryDescription"]
            </MudText>
        </div>
    </header>

    @if (_loading && _inventory is null)
    {
        <div class="inventory-loading" role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" aria-label="@(InterfacesText["LoadingAria"])" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@InterfacesText["LoadingInventory"]</MudText>
        </div>
    }
    else if (_inventory is { Interfaces.Count: 0 })
    {
        <div class="inventory-empty">
            <MudIcon Icon="@Icons.Material.Filled.Lan" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1">@InterfacesText["NoKnownInterfaces"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @InterfacesText["NoKnownInterfacesDescription"]
            </MudText>
        </div>
    }
    else if (_inventory is not null)
    {
        <MudTable T="NetworkInterfaceInventoryItem"
                  Items="@_inventory.Interfaces"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Class="inventory-desktop">
            <HeaderContent>
                <MudTh Class="interface-visibility-column">@InterfacesText["VisibilityColumn"]</MudTh>
                <MudTh>@InterfacesText["InterfaceColumn"]</MudTh>
                <MudTh>@InterfacesText["CommentColumn"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@(InterfacesText["VisibilityColumn"])" Class="interface-visibility-column">
                    <div>
                        <MudTooltip Text="@VisibilityActionText(context)">
                            <MudIconButton Icon="@(context.IsVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           Color="@(context.IsVisible ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => UpdateVisibilityAsync(context, !context.IsVisible))"
                                           aria-label="@VisibilityActionText(context)" />
                        </MudTooltip>
                    </div>
                </MudTd>
                <MudTd DataLabel="@(InterfacesText["InterfaceColumn"])">
                    <code class="interface-name">@context.Name</code>
                </MudTd>
                <MudTd DataLabel="@(InterfacesText["CommentColumn"])">
                    <div class="interface-comment-cell">
                        <span class="@(string.IsNullOrWhiteSpace(context.Comment) ? "interface-comment-empty" : "interface-comment")">
                            @(string.IsNullOrWhiteSpace(context.Comment) ? InterfacesText["NoComment"] : context.Comment)
                        </span>
                        <MudTooltip Text="@(InterfacesText["EditComment"])">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => EditCommentAsync(context))"
                                           aria-label="@(InterfacesText["EditCommentAria", context.Name])" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="inventory-mobile">
            @foreach (NetworkInterfaceInventoryItem item in _inventory.Interfaces)
            {
                <article>
                    <div class="inventory-mobile-visibility">
                        <MudTooltip Text="@VisibilityActionText(item)">
                            <MudIconButton Icon="@(item.IsVisible ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           Color="@(item.IsVisible ? Color.Primary : Color.Default)"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => UpdateVisibilityAsync(item, !item.IsVisible))"
                                           aria-label="@VisibilityActionText(item)" />
                        </MudTooltip>
                    </div>
                    <div class="inventory-mobile-copy">
                        <code class="interface-name">@item.Name</code>
                        <span class="@(string.IsNullOrWhiteSpace(item.Comment) ? "interface-comment-empty" : "interface-comment")">
                            @(string.IsNullOrWhiteSpace(item.Comment) ? InterfacesText["NoComment"] : item.Comment)
                        </span>
                    </div>
                    <div class="inventory-mobile-actions">
                        <MudTooltip Text="@(InterfacesText["EditComment"])">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => EditCommentAsync(item))"
                                           aria-label="@(InterfacesText["EditCommentAria", item.Name])" />
                        </MudTooltip>
                    </div>
                </article>
            }
        </div>
    }
</MudPaper>
