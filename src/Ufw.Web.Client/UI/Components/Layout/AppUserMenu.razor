@inject IClientThemeService Theme
@inject IStringLocalizer<CommonStrings> CommonText

<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         PopoverClass="appbar-account-popover"
         ListClass="appbar-account-menu-list">
    <ActivatorContent Context="menu">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.AccountCircle"
                   EndIcon="@Icons.Material.Filled.ArrowDropDown"
                   Disabled="@(_themeBusy || SignOutBusy)"
                   OnClick="@menu.ToggleAsync"
                   Class="appbar-account-button"
                   title="@UserName"
                   aria-label="@UserName"
                   aria-haspopup="menu">
            <span class="appbar-account-name">@UserName</span>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Icon="@ThemeActionIcon"
                     Disabled="@(_themeBusy || SignOutBusy)"
                     OnClick="ToggleThemeAsync">
            @ThemeActionLabel
        </MudMenuItem>
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                     Disabled="@(_themeBusy || SignOutBusy)"
                     OnClick="SignOutAsync">
            @(SignOutBusy ? CommonText["SigningOut"] : CommonText["SignOut"])
        </MudMenuItem>
    </ChildContent>
</MudMenu>
