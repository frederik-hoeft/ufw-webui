@inherits RuleFilterEditorBase
@inject IFirewallRuleText RuleText
@inject IStringLocalizer<RulesStrings> RulesText

<KnownHostField Label="@EditorLabel"
                Placeholder="@Placeholder"
                Value="@_value"
                ValueChanged="ValueChanged"
                Suggestions="@_suggestions"
                AddressFamily="@AddressFamily" />
@if (_error is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error">@_error</MudText>
}
