@inject IUfwRuleCommandRenderer UfwRuleCommandRenderer
@inject IStringLocalizer<RulesStrings> RulesText

<div class="ufw-command-preview" role="group" aria-label="@EffectiveLabel">
    <span>@EffectiveLabel</span>
    @if (TryGetCommandText(out string? commandText))
    {
        <code>@commandText</code>
    }
    else
    {
        <p>@RulesText["CommandPreviewEmpty"]</p>
    }
    @if (Details is not null)
    {
        <div>
            @Details
        </div>
    }
</div>
