@inject IStringLocalizer<RulesStrings> RulesText

<MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
         Size="Size.Small"
         Dense="true"
         Class="rule-actions-menu"
         PopoverClass="rule-actions-menu-popover"
         aria-label="@ActionsLabel">
    <MudMenuItem Disabled="@(OrderingDisabled || !CanOrder)"
                 Icon="@Icons.Material.Filled.DragIndicator"
                 OnClick="@(() => MoveToPositionRequested.InvokeAsync())">
        @RulesText["MoveToPosition"]
    </MudMenuItem>
    <MudMenuItem Disabled="@(InsertionDisabled || !CanOrder)"
                 Icon="@Icons.Material.Filled.VerticalAlignTop"
                 OnClick="@(() => RequestInsertionAsync(RuleInsertionPlacement.Before))">
        @RulesText["InsertBefore"]
    </MudMenuItem>
    <MudMenuItem Disabled="@(InsertionDisabled || !CanOrder)"
                 Icon="@Icons.Material.Filled.VerticalAlignBottom"
                 OnClick="@(() => RequestInsertionAsync(RuleInsertionPlacement.After))">
        @RulesText["InsertAfter"]
    </MudMenuItem>
    <MudDivider />
    @if (EditRequested.HasDelegate)
    {
        <MudMenuItem Disabled="@(MutationDisabled || !CanEdit)"
                     Icon="@Icons.Material.Filled.Edit"
                     OnClick="@(() => EditRequested.InvokeAsync())">
            @RulesText["EditRule"]
        </MudMenuItem>
    }
    @if (MetadataEditRequested.HasDelegate)
    {
        <MudMenuItem Disabled="@MetadataEditDisabled"
                     Icon="@Icons.Material.Filled.Edit"
                     OnClick="@(() => MetadataEditRequested.InvokeAsync())">
            @RulesText["EditMetadata"]
        </MudMenuItem>
    }
    @if (SaveAsTemplateRequested.HasDelegate)
    {
        <MudMenuItem Disabled="@(TemplateSaveDisabled || !CanSaveAsTemplate)"
                     Icon="@Icons.Material.Filled.Bookmarks"
                     OnClick="@(() => SaveAsTemplateRequested.InvokeAsync())">
            @RulesText["SaveAsTemplate"]
        </MudMenuItem>
    }
    <MudDivider />
    @if (DisableRequested.HasDelegate)
    {
        <MudMenuItem Disabled="@(MutationDisabled || !CanMutate)"
                     Icon="@Icons.Material.Filled.Block"
                     OnClick="@(() => DisableRequested.InvokeAsync())">
            @RulesText["DisableRule"]
        </MudMenuItem>
    }
    <MudMenuItem Disabled="@(MutationDisabled || !CanMutate)"
                 Icon="@Icons.Material.Filled.Delete"
                 IconColor="Color.Error"
                 OnClick="@(() => DeleteRequested.InvokeAsync(Rule))"
                 Class="delete">
        @RulesText["DeleteRule"]
    </MudMenuItem>
</MudMenu>
