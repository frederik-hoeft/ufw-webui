@using Ufw.Web.Client.Features.Rules.Metadata
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@RulesText["DeleteTagConfirmation", Tag.Name]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@RulesText["DeleteTagDescription"]</MudText>
    </DialogContent>
    <DialogActions>
        <div class="delete-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="Cancel">@CommonText["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">@RulesText["DeleteTag"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>
