@inject IKnownHostInventoryService KnownHosts
@inject IKnownHostEditorDialogService KnownHostEditor
@inject IRuleEndpointKnownHostProjectionService ProjectionService
@inject IClientErrorMapper ClientErrors
@inject ISnackbar Snackbar
@inject IStringLocalizer<KnownHostsStrings> HostsText
@inject IStringLocalizer<RulesStrings> RulesText

<div class="rule-known-host-endpoint">
    <span>@Label</span>
    @if (!Projection.IsMeaningful)
    {
        <span>@RulesText["AnyAddress"]</span>
    }
    else if (KnownHosts.Current is null)
    {
        <div class="unavailable">
            <code>@Projection.Address</code>
            <span>@HostsText["LoadFailed"]</span>
        </div>
    }
    else if (Projection.Hosts.Count > 0)
    {
        <div class="aliases">
            @foreach (KnownHostInventoryItem host in Projection.Hosts)
            {
                <div @key="host.Id">
                    <span>@host.Name</span>
                    <code>@host.Address</code>
                    <MudTooltip Text="@(HostsText["EditHostAria", host.Name])">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Disabled="@_busy"
                                       OnClick="@(() => EditAsync(host))"
                                       aria-label="@(HostsText["EditHostAria", host.Name])" />
                    </MudTooltip>
                </div>
            }
        </div>
    }
    else
    {
        <div class="unmapped">
            <code>@Projection.Address</code>
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@_busy"
                       OnClick="CreateAsync">
                @RulesText["CreateKnownHost"]
            </MudButton>
        </div>
    }
</div>
