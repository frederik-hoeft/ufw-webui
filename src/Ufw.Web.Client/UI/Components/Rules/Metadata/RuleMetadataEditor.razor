@using Ufw.Web.Client.Features.Rules.Metadata
@inject IRuleTagCatalogService TagCatalog
@inject IRuleTagColorGenerator TagColors
@inject IRuleGroupCatalogService GroupCatalog
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<RulesStrings> RulesText

<MudForm @ref="_form">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3" role="alert">
            @_error.Message
        </MudAlert>
    }

    <MudTextField T="string"
                  Label="@(RulesText["Notes"])"
                  Value="@Value.Notes"
                  ValueChanged="NotesChangedAsync"
                  Lines="5"
                  Immediate="true"
                  Counter="@MAX_NOTES_LENGTH"
                  MaxLength="@MAX_NOTES_LENGTH"
                  Disabled="@Disabled"
                  Placeholder="@(RulesText["NotesPlaceholder"])" />

    <div class="rule-metadata-editor mt-4">
        <MudText Typo="Typo.subtitle2">@RulesText["Group"]</MudText>
        <MudAutocomplete T="GroupOption"
                         Label="@(RulesText["RuleGroup"])"
                         Value="@_groupSelection"
                         ValueChanged="GroupChangedAsync"
                         SearchFunc="SearchGroupsAsync"
                         ToStringFunc="FormatGroupOption"
                         CoerceValue="false"
                         ResetValueOnEmptyText="true"
                         Clearable="true"
                         Disabled="@(Disabled || _creatingGroup)"
                         MaxItems="@((int?)null)"
                         Placeholder="@(RulesText["AddOrCreateGroupPlaceholder"])">
            <ItemTemplate Context="option">
                @if (option.Group is { } group)
                {
                    <div class="rule-group-select-option">
                        <span>@group.Name</span>
                        @if (!string.IsNullOrWhiteSpace(group.Comment))
                        {
                            <small>@group.Comment</small>
                        }
                    </div>
                }
                else
                {
                    <span class="rule-tag-create-option">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        <span>@RulesText["CreateInlineGroup", option.CreateName ?? string.Empty]</span>
                    </span>
                }
            </ItemTemplate>
        </MudAutocomplete>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @RulesText["InlineGroupCreationHint"]
        </MudText>
    </div>

    <div class="rule-metadata-editor mt-4">
        <MudText Typo="Typo.subtitle2">@RulesText["Tags"]</MudText>
        @if (SelectedTags.Count > 0)
        {
            <div class="selected-tags">
                @foreach (RuleTag tag in SelectedTags)
                {
                    <RuleTagChip Tag="@tag" Disabled="@Disabled" OnRemove="@(() => RemoveTagAsync(tag.Id))" />
                }
            </div>
        }

        <MudAutocomplete T="TagOption"
                         @ref="_tagAutocomplete"
                         Label="@(RulesText["AddTagToRule"])"
                         Value="@_tagToAdd"
                         ValueChanged="AddTagAsync"
                         SearchFunc="SearchTagsAsync"
                         ToStringFunc="FormatTagOption"
                         CoerceValue="false"
                         ResetValueOnEmptyText="true"
                         Clearable="true"
                         Disabled="@(Disabled || _creatingTag)"
                         MaxItems="@((int?)null)"
                         Placeholder="@(RulesText["AddOrCreateTagPlaceholder"])">
            <ItemTemplate Context="option">
                @if (option.Tag is { } tag)
                {
                    <span class="rule-tag-select-option">
                        <span class="rule-tag-color" style="background-color: @tag.Color"></span>
                        <span>@tag.Name</span>
                    </span>
                }
                else
                {
                    <span class="rule-tag-create-option">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        <span>@RulesText["CreateInlineTag", option.CreateName ?? string.Empty]</span>
                    </span>
                }
            </ItemTemplate>
        </MudAutocomplete>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @RulesText["InlineTagCreationHint"]
        </MudText>
    </div>
</MudForm>
