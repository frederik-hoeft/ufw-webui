@using Ufw.Web.Client.Features.Rules.Metadata
@inject IRuleMetadataAuthoringService Authoring
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <div class="rule-group-editor">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(Group is null ? RulesText["CreateGroupDescription"] : RulesText["EditGroupDescription"])
            </MudText>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">@_error.Message</MudAlert>
            }

            <MudTextField T="string"
                          Label="@(RulesText["GroupName"])"
                          @bind-Value="_name"
                          Immediate="true"
                          Required="true"
                          Counter="@RuleGroupLimits.MAX_NAME_LENGTH"
                          MaxLength="@RuleGroupLimits.MAX_NAME_LENGTH"
                          Disabled="@Saving"
                          autofocus="true" />
            <MudTextField T="string"
                          Label="@(RulesText["GroupComment"])"
                          @bind-Value="_comment"
                          Immediate="true"
                          Lines="4"
                          Counter="@RuleGroupLimits.MAX_COMMENT_LENGTH"
                          MaxLength="@RuleGroupLimits.MAX_COMMENT_LENGTH"
                          Disabled="@Saving" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@Saving" OnClick="Cancel">@CommonText["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSave)" OnClick="SaveAsync">
            @(Saving ? RulesText["SavingGroup"] : RulesText["SaveGroup"])
        </MudButton>
    </DialogActions>
</MudDialog>
