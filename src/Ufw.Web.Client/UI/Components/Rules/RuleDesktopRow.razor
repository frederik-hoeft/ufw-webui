
@{
    ListedFirewallRule rule = Row.Rule;
}

<tbody class="@GroupClass">
@if (rule.Parsed && rule.Rule is not null)
{
    <tr class="@RowClass"
        tabindex="@(DetailsAvailable ? "0" : null)"
        @onclick="ToggleMetadata"
        @onkeydown="HandleKeyDown"
        @ondragenter="@DragEnterHandler"
        @ondragover:preventDefault
        @ondrop="DropAsync">
        <td class="drag" @onclick:stopPropagation="true">
            <RuleRowDragHandle Row="@Row"
                               OrderingDisabled="@OrderingDisabled"
                               DragStarted="@DragStarted"
                               DragEnded="@DragEnded" />
        </td>
        <td class="position">
            <RuleRowPosition FamilyPosition="@Row.FamilyPosition" Change="@Row.PositionChange" />
        </td>
        <RuleDesktopContent Rule="@rule.Rule" Tags="@(Row.Metadata?.Tags ?? [])" />
        <td class="actions" @onclick:stopPropagation="true">
            <RuleRowActions Row="@Row"
                            Handlers="@Actions"
                            MetadataEditDisabled="@MetadataEditDisabled"
                            TemplateSaveDisabled="@TemplateSaveDisabled"
                            OrderingDisabled="@OrderingDisabled"
                            InsertionDisabled="@InsertionDisabled"
                            MutationDisabled="@MutationDisabled" />
        </td>
    </tr>
}
else
{
    <tr class="@ReadOnlyRowClass"
        @ondragenter="@DragEnterHandler"
        @ondragover:preventDefault
        @ondrop="DropAsync">
        <td class="drag">
            <span class="rule-drag-handle rule-drag-handle-disabled" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
            </span>
        </td>
        <td class="position">
            <RuleRowPosition FamilyPosition="@Row.FamilyPosition" Change="@Row.PositionChange" ReadOnly="true" />
        </td>
        <td colspan="7">
            <div class="unsupported">
                <RuleRowReadOnlyContent RawLine="@rule.RawLine" />
            </div>
        </td>
        <td class="actions">
            <RuleRowReadOnlyIndicator />
        </td>
    </tr>
}
@if (MatchEvidence.Count > 0)
{
    <tr class="rule-match-context-row">
        <td colspan="10">
            <RuleMatchContext Evidence="@MatchEvidence" />
        </td>
    </tr>
}
@if (_interaction.MetadataExpanded && DetailsAvailable)
{
    <tr class="rule-metadata-details-row">
        <td colspan="10">
            <RuleRowMetadataDetails Row="@Row"
                                    KnownHostsChanged="@KnownHostsChanged"
                                    CollapseRequested="@ToggleMetadata" />
        </td>
    </tr>
}

</tbody>
