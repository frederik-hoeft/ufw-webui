@inject IStringLocalizer<RulesStrings> RulesText

@if (!Assessment.IsClean)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1">@RulesText["FirewallAmbiguousTitle"]</MudText>
        <MudText Typo="Typo.body2">@RulesText["FirewallAmbiguousDescription"]</MudText>
        @foreach (FirewallStateIssue issue in Assessment.Issues)
        {
            <MudText Typo="Typo.caption">@RulesText["FirewallAmbiguousDuplicateRule", issue.RuleId, string.Join(", ", issue.OccurrenceIds.Select(static id => id + 1))]</MudText>
        }
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public FirewallStateAssessment Assessment { get; set; } = null!;
}
