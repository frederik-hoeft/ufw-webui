{
  "debug_mode": true,
  "ufw_path": "/usr/sbin/ufw",
  "write_to_console": true,
  "pipe": {
    "pipe_name": "/var/run/ufw-systemd.pipe",
    "ssl_protocols": "none",
    "remote_certificate_validation": null,
    "server_certificate_path": "/etc/ufw-manager/cert.pem",
    "server_certificate_key_path": "/etc/ufw-manager/key.pem"
  },
  "network": {
    "max_connections": 8,
    "io_timeout": "00:00:30",
    "request_timeout": "00:30:00"
  }
}
