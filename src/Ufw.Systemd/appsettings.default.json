{
  "debug_mode": true,
  "expose_remote_exception_details": false,
  "ufw_path": "/usr/sbin/ufw",
  "ufw_defaults_path": "/etc/default/ufw",
  "transport": {
    "type": "pipe",
    "pipe": {
      "pipe_name": "/var/run/ufw-systemd.pipe"
    },
    "tcp": null,
    "security": {
      "tls_enabled": false,
      "ssl_protocols": "none",
      "remote_certificate_validation": null,
      "server_certificate_path": null,
      "server_certificate_key_path": null
    }
  },
  "network": {
    "max_connections": 8,
    "io_timeout": "00:00:30",
    "request_timeout": "00:30:00"
  },
  "security": {
    "authorized_keys_path": "/etc/ufw-manager/authorized_keys",
    "nonce_store_path": "/var/lib/ufw-manager/intent-nonces",
    "deployment_id_path": "/var/lib/ufw-manager/deployment-id",
    "reorder_recovery_journal_path": "/var/lib/ufw-manager/reorder-recovery.json",
    "max_intent_age": "00:05:00",
    "clock_skew": "00:00:30"
  }
}
