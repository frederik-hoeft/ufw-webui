@page
@model UfwWebUI.Pages.Rules.DeleteModel
@{
    ViewData["Title"] = "Delete Rule";
}

<h1>Delete Rule</h1>

<h3>Are you sure you want to delete this rule?</h3>
<div>
    <h4>UFW Rule</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Type)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Type)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.IsRoute)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.IsRoute)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Direction)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Direction)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Interface)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Interface)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Source)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Source)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Target)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Target)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Protocol)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Protocol)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Ports)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Ports)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Comment)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.UfwRule.Comment)
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.CreatedDate)
        </dt>
        <dd class="col-sm-9">
            @Model.UfwRule.CreatedDate.ToLocalTime().ToString("g")
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="UfwRule.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
