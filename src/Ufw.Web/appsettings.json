{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "ufw-webui",
      "Audience": "ufw-webui-client",
      "SigningKeyPath": "",
      "AccessTokenLifetime": "00:05:00",
      "ClockSkew": "00:00:30"
    },
    "RefreshToken": {
      "CookieName": "__Host-ufw-refresh",
      "Lifetime": "30.00:00:00"
    },
    "Bootstrap": {
      "Users": []
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "IpcOptions": {
    "Endpoint": "/run/ufw-systemd.pipe",
    "TlsEnabled": false,
    "TlsServerName": "",
    "SslProtocols": "None",
    "ClientCertificatePath": "",
    "ClientCertificateKeyPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
