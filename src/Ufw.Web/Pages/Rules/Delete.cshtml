@page
@using Ufw.Web.Models
@using Ufw.Web.Pages.Rules
@model Ufw.Web.Pages.Rules.DeleteModel
@{
    ViewData["Title"] = "Delete Rule";
}

<h1>Delete Rule</h1>

<h3>Are you sure you want to delete this rule?</h3>
<div>
    <h4>UFW Rule</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Type)
        </dt>
        <dd class="col-sm-9">
            @Model.UfwRule.Type.ToString().ToLowerInvariant()
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.IsRoute)
        </dt>
        <dd class="col-sm-9">
            @(Model.UfwRule.IsRoute ? "yes" : "no")
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Direction)
        </dt>
        <dd class="col-sm-9">
            @Model.UfwRule.Direction.ToString().ToLowerInvariant()
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Interface)
        </dt>
        <dd class="col-sm-9">
            @if (Model.DisplayService.IsAnyValue(Model.UfwRule.Interface))
            {
                <span class="ufw-any">any</span>
            }
            else
            {
                @Model.UfwRule.Interface
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Source)
        </dt>
        <dd class="col-sm-9">
            @if (Model.DisplayService.IsAnyValue(Model.UfwRule.Source))
            {
                <span class="ufw-any">any</span>
            }
            else
            {
                @Model.DisplayService.GetDisplayValue(Model.UfwRule.Source)
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Target)
        </dt>
        <dd class="col-sm-9">
            @if (Model.DisplayService.IsAnyValue(Model.UfwRule.Target))
            {
                <span class="ufw-any">any</span>
            }
            else
            {
                @Model.DisplayService.GetDisplayValue(Model.UfwRule.Target)
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Protocol)
        </dt>
        <dd class="col-sm-9">
            @if (Model.UfwRule.Protocol == UfwProtocol.Any)
            {
                <span class="ufw-any">any</span>
            }
            else
            {
                @Model.UfwRule.Protocol.ToString().ToLowerInvariant()
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Ports)
        </dt>
        <dd class="col-sm-9">
            @if (Model.DisplayService.IsAnyValue(Model.UfwRule.Ports))
            {
                <span class="ufw-any">any</span>
            }
            else
            {
                @Model.UfwRule.Ports
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.Comment)
        </dt>
        <dd class="col-sm-9">
            @if (string.IsNullOrWhiteSpace(Model.UfwRule.Comment))
            {
                <span class="text-muted">-</span>
            }
            else
            {
                @Model.UfwRule.Comment
            }
        </dd>
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.UfwRule.CreatedDate)
        </dt>
        <dd class="col-sm-9">
            @Model.UfwRule.CreatedDate.ToLocalTime().ToString("g")
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="UfwRule.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
