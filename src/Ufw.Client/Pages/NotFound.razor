@page "/not-found"
@layout LoginLayout
@inject IStringLocalizer<StandaloneStrings> StandaloneText

<PageTitle>@StandaloneText["PageNotFoundTitle"] - UFW Console</PageTitle>

<StandalonePanel Title="@(StandaloneText["PageNotFoundTitle"])"
                 Description="@(StandaloneText["PageNotFoundDescription"])"
                 Icon="@Icons.Material.Filled.SearchOff"
                 IconColor="Color.Secondary"
                 Class="standalone-state-card">
    <Actions>
        <MudButton Href="/rules"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            @StandaloneText["GoToFirewallRules"]
        </MudButton>
    </Actions>
</StandalonePanel>
