@page "/not-found"
@layout LoginLayout

<PageTitle>Page not found - UFW Management</PageTitle>

<MudPaper Class="login-card pa-8 text-center" Elevation="1">
    <MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true">Page not found</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        The requested page does not exist.
