@page "/not-found"
@layout LoginLayout

<PageTitle>Page not found - UFW Console</PageTitle>

<StandalonePanel Title="Page not found"
                 Description="The requested page does not exist or is no longer available."
                 Icon="@Icons.Material.Filled.SearchOff"
                 IconColor="Color.Secondary"
                 Class="standalone-state-card">
    <Actions>
        <MudButton Href="/rules"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ArrowBack">
            Go to firewall rules
        </MudButton>
    </Actions>
</StandalonePanel>
