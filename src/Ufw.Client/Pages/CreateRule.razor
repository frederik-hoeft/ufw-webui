@using Ufw.Shared.Ipc.Model.Responses.Domain
@page "/rules/create"
@attribute [Authorize]
@implements IDisposable
@inject IRuleApiClient RuleApiClient
@inject IRuleMutationService RuleMutations
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<PageTitle>@RulesText["CreatePageTitle"] - UFW Console</PageTitle>

<div class="rule-create-page">
<PageHeader Title="@(RulesText["CreateTitle"])"
            Description="@HeaderDescription"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_state.Snapshot is not null)">
    <Actions>
        <MudButton Href="/rules"
                   Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Disabled="@_submitting"
                   Class="page-header-button">
            @RulesText["BackToRules"]
        </MudButton>
    </Actions>
    <Status>
        @if (_state.Snapshot is { } snapshot)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(snapshot.FirewallActive ? "page-status-chip page-status-chip-success" : "page-status-chip page-status-chip-warning")">
                @(snapshot.FirewallActive ? RulesText["FirewallActive"] : RulesText["FirewallInactive"])
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeRuleCount(snapshot.Rules.Count)
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(_state.IsStale ? "page-status-chip page-status-chip-warning" : "page-status-chip")">
                @DescribeSnapshotStatus()
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_state.Status == RulesPageStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_state.Error?.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_submitting"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}
else if (_state.Snapshot is null)
{
    <MudPaper Class="pa-5" Elevation="1" role="status" aria-live="polite">
        <MudProgressLinear Indeterminate="true" Class="mb-3" aria-label="@(RulesText["LoadingStateAria"])" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @RulesText["LoadingBeforeCreate"]
        </MudText>
    </MudPaper>
}
else
{
    @if (_state.IsStale)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["StaleTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeStaleState()</MudText>
            @if (_state.Error is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_state.Error.Message</MudText>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_submitting"
                       OnClick="RefreshAsync">
                @RulesText["RefreshAuthoritative"]
            </MudButton>
        </MudAlert>
    }
    else if (_state.Status == RulesPageStatus.Refreshing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">
                @(_mutationMayHaveCompleted
                    ? RulesText["RuleSubmissionConfirming"]
                    : RulesText["RefreshingAuthoritative"])
            </MudText>
        </MudAlert>
    }

    @if (IsOrderedInsertionRequested)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="note">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["OrderedInsertionPrototype"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@DescribeInsertionTarget()</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@RulesText["OrderedInsertionDescription"]</MudText>
            <MudButton Href="/rules/create" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add">
                @RulesText["CreateAtEndInstead"]
            </MudButton>
        </MudAlert>
    }

    <RuleEditor @key="_draft"
                Rule="@_draft"
                DefinitionDescription="@RuleDefinitionDescription"
                Disabled="@(!CanEdit)"
                SubmitDisabled="@IsOrderedInsertionRequested"
                ShowAuthorization="@(!IsOrderedInsertionRequested)"
                SubmitLabel="@(IsOrderedInsertionRequested ? RulesText["OrderedInsertionPending"] : RulesText["AddSignedRule"])"
                Submitting="@_submitting"
                @bind-PrivateKey="_privateKey"
                OnSubmit="AddRuleAsync"
                OnCancel="Cancel" />
}
</div>
