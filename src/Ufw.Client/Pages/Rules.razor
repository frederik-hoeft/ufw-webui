@page "/rules"
@attribute [Authorize]
@implements IDisposable
@inject IRuleApiClient RuleApiClient
@inject IRuleMutationService RuleMutations
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IRuleOrderingService RuleOrdering
@inject IRuleOrderingProjectionService RuleOrderingProjection
@inject IRuleInsertionNavigationService InsertionNavigation
@inject IFirewallRuleText RuleText
@inject NavigationManager Navigation
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<PageTitle>@RulesText["RulesPageTitle"] - UFW Console</PageTitle>

<PageHeader Title="@(RulesText["RulesTitle"])"
            Description="@(RulesText["RulesDescription"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_state.Snapshot is not null)">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @RefreshButtonLabel
        </MudButton>
        <MudButton Href="/rules/create"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!CanMutateFirewall)"
                   Class="page-header-button">
            @RulesText["AddRule"]
        </MudButton>
    </Actions>
    <Status>
        @if (_state.Snapshot is { } headerSnapshot)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(headerSnapshot.FirewallActive ? "page-status-chip page-status-chip-success" : "page-status-chip page-status-chip-warning")">
                @(headerSnapshot.FirewallActive ? RulesText["FirewallActive"] : RulesText["FirewallInactive"])
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeRuleCount(headerSnapshot.Rules.Count)
            </MudChip>
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Filled"
                     Class="@(_state.IsStale ? "page-status-chip page-status-chip-warning" : "page-status-chip")">
                @DescribeSnapshotStatus()
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_state.Status == RulesPageStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_state.Error?.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}
else if (_state.Snapshot is null)
{
    <MudPaper Class="pa-5" Elevation="1" role="status" aria-live="polite">
        <MudProgressLinear Indeterminate="true" Class="mb-3" aria-label="@(RulesText["LoadingStateAria"])" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @RulesText["LoadingAuthoritativeState"]
        </MudText>
    </MudPaper>
}
else if (_state.Snapshot is { })
{
    @if (_state.IsStale)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["DisplayedStateStale"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeStaleState()</MudText>
            @if (_state.Error is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_state.Error.Message</MudText>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@IsBusy"
                       OnClick="RefreshAsync">
                @RulesText["RefreshAuthoritative"]
            </MudButton>
        </MudAlert>
    }
    else if (_state.Status == RulesPageStatus.Refreshing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">
                @(_state.RefreshReason == RuleRefreshReason.AfterMutation
                    ? RulesText["RuleChangeAcceptedRefreshing"]
                    : RulesText["RefreshingAuthoritative"])
            </MudText>
        </MudAlert>
    }
    else if (_deleting)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">@RulesText["DeletingRule"]</MudText>
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="pa-4 mb-5" role="region" aria-labelledby="firewall-defaults-heading">
        <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="firewall-defaults-heading" Class="mb-2">@RulesText["FirewallDefaults"]</MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-2 mb-1">
            @RulesText["DefaultIncoming"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.IncomingPolicy)
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-2 mb-1">
            @RulesText["DefaultOutgoing"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.OutgoingPolicy)
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-2 mb-1">
            @RulesText["DefaultRouted"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.RoutedPolicy)
        </MudChip>
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Filled"
                 Class="@(_state.Snapshot.Configuration.IPv6Enabled ? "page-status-chip page-status-chip-success mb-1" : "page-status-chip page-status-chip-warning mb-1")">
            @(_state.Snapshot.Configuration.IPv6Enabled ? RulesText["IPv6CapabilityEnabled"] : RulesText["IPv6CapabilityDisabled"])
        </MudChip>
    </MudPaper>

    @if (HasOrderingPreview)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5 rule-ordering-preview-alert" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LocalOrderingPreview"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@RulesText["LocalOrderingPreviewDescription"]</MudText>
            <div class="mb-3">
                <MutationAuthorizationField @bind-Value="_orderingPrivateKey" Disabled="@_reordering" />
            </div>
            <footer>
                <MudButton Variant="Variant.Text" Disabled="@_reordering" OnClick="DiscardOrderingPreview">
                    @RulesText["DiscardPreview"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_reordering"
                           OnClick="RefreshAsync">
                    @RulesText["ReloadAuthoritativeState"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(_reordering || string.IsNullOrWhiteSpace(_orderingPrivateKey))"
                           OnClick="ApplyOrderingPreviewAsync">
                    @(_reordering ? RulesText["ApplyingReordering"] : RulesText["ApplyReordering"])
                </MudButton>
            </footer>
        </MudAlert>
    }

    @if (_orderingResult is { } orderingResult)
    {
        <RuleOrderingResultAlert Result="@orderingResult" />
    }

    <RuleTable Rules="@DisplayedRules"
               OrderingPreview="@_orderingPreview"
               Loading="@(_state.Status == RulesPageStatus.Refreshing || _reordering)"
               Disabled="@(!CanMutateFirewall)"
               OrderingDisabled="@(!CanPreviewOrdering)"
               InsertionDisabled="@(!CanPreviewOrdering || HasOrderingPreview)"
               DeleteRequested="BeginDeleteAsync"
               InsertionRequested="BeginOrderedInsertionAsync"
               MoveRequested="MoveRuleAsync" />
}
