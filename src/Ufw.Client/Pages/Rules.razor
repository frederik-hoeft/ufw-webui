@page "/"
@attribute [Authorize]
@implements IDisposable
@inject IUfwApiClient UfwApiClient
@inject ISnackbar Snackbar

<PageTitle>Firewall rules - UFW Management</PageTitle>

<div class="d-flex flex-wrap align-center gap-3 mb-5">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Firewall rules</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Authoritative rules reported by the privileged UFW daemon.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="@IsBusy"
               OnClick="LoadAsync">
        Refresh
    </MudButton>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
}

<RuleEditor @key="_draft"
            Rule="@_draft"
            FirewallActive="@_active"
            Disabled="@IsBusy"
            @bind-PrivateKey="_addPrivateKey"
            OnSubmit="AddRuleAsync" />

@if (_pendingDelete is not null)
{
    <DeleteRuleConfirmation Rule="@_pendingDelete"
                            Disabled="@IsBusy"
                            @bind-PrivateKey="_deletePrivateKey"
                            OnConfirm="DeleteRuleAsync"
                            OnCancel="CancelDelete" />
}

<RuleTable Rules="@_rules"
           Loading="@_loading"
           Disabled="@IsBusy"
           DeleteRequested="BeginDelete" />

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<ListedFirewallRule> _rules = [];
    private FirewallRuleSpecification _draft = CreateDefaultRule();
    private ListedFirewallRule? _pendingDelete;
    private string _addPrivateKey = string.Empty;
    private string _deletePrivateKey = string.Empty;
    private string? _loadError;
    private bool _active;
    private bool _loading;
    private bool _mutating;

    private bool IsBusy => _loading || _mutating;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _loadError = null;
        try
        {
            Ufw.Ipc.Shared.Model.Responses.Domain.RuleListResponse response = await UfwApiClient.GetRulesAsync(_lifetime.Token);
            _active = response.Active;
            _rules = response.Rules;
            ReconcilePendingDelete(response.Rules);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is ApiRequestException or HttpRequestException or InvalidOperationException)
        {
            _loadError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddRuleAsync()
    {
        if (IsBusy || string.IsNullOrWhiteSpace(_addPrivateKey))
        {
            return;
        }

        _mutating = true;
        try
        {
            FirewallRuleSpecification normalized = RuleSpecificationNormalizer.Normalize(_draft);
            await UfwApiClient.AddRuleAsync(normalized, _addPrivateKey, _lifetime.Token);
            Snackbar.Add("Firewall rule added.", Severity.Success);
            _draft = CreateDefaultRule();
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (IsMutationException(exception))
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _addPrivateKey = string.Empty;
            _mutating = false;
        }
    }

    private void BeginDelete(ListedFirewallRule rule)
    {
        if (IsBusy || !rule.Parsed || rule.Rule is null || string.IsNullOrWhiteSpace(rule.RuleId))
        {
            return;
        }

        _deletePrivateKey = string.Empty;
        _pendingDelete = rule;
    }

    private void CancelDelete()
    {
        _deletePrivateKey = string.Empty;
        _pendingDelete = null;
    }

    private async Task DeleteRuleAsync()
    {
        if (IsBusy || _pendingDelete is null || string.IsNullOrWhiteSpace(_deletePrivateKey))
        {
            return;
        }

        _mutating = true;
        try
        {
            await UfwApiClient.DeleteRuleAsync(_pendingDelete, _deletePrivateKey, _lifetime.Token);
            Snackbar.Add("Firewall rule deleted.", Severity.Success);
            _pendingDelete = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (IsMutationException(exception))
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _deletePrivateKey = string.Empty;
            _mutating = false;
        }
    }

    private void ReconcilePendingDelete(IReadOnlyList<ListedFirewallRule> rules)
    {
        if (_pendingDelete?.RuleId is not { Length: > 0 } ruleId)
        {
            return;
        }

        ListedFirewallRule? current = rules.FirstOrDefault(rule => string.Equals(rule.RuleId, ruleId, StringComparison.Ordinal));
        if (current is null || !current.Parsed || current.Rule is null)
        {
            CancelDelete();
            return;
        }

        _pendingDelete = current;
    }

    private static FirewallRuleSpecification CreateDefaultRule() => new()
    {
        Action = FirewallAction.Allow,
        AddressFamily = FirewallAddressFamily.Any,
        Direction = FirewallDirection.In,
        Protocol = FirewallProtocol.Any,
        Source = RuleSpecificationNormalizer.ANY,
        Destination = RuleSpecificationNormalizer.ANY,
    };

    private static bool IsMutationException(Exception exception) =>
        exception is ApiRequestException
            or HttpRequestException
            or InvalidOperationException
            or ArgumentException
            or Microsoft.JSInterop.JSException;
}
