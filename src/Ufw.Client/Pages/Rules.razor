@page "/rules"
@attribute [Authorize]
@using Ufw.Client.Rules.Filtering.Tags
@using Ufw.Client.Rules.Metadata
@implements IDisposable
@inject IRuleApiClient RuleApiClient
@inject IRuleMutationService RuleMutations
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IRuleOrderingService RuleOrdering
@inject IRuleOrderingProjectionService RuleOrderingProjection
@inject IRuleListProjectionService RuleListProjectionService
@inject IRuleQueryService RuleQueryService
@inject IRuleTagFilterReconciler RuleTagFilters
@inject IRuleTagCatalogService RuleTags
@inject IRuleInsertionNavigationService InsertionNavigation
@inject IFirewallRuleText RuleText
@inject NavigationManager Navigation
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<PageTitle>@RulesText["RulesPageTitle"] - UFWeb</PageTitle>

<PageHeader Title="@(RulesText["RulesTitle"])"
            Description="@(RulesText["RulesDescription"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="false">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @RefreshButtonLabel
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.Label"
                   Disabled="@(!CanManageTags)"
                   OnClick="ManageTagsAsync"
                   Class="page-header-button">
            @RulesText["ManageTags"]
        </MudButton>
        <MudButton Href="/rules/create"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(!CanMutateFirewall)"
                   Class="page-header-button">
            @RulesText["AddRule"]
        </MudButton>
    </Actions>
</PageHeader>

@if (_state.Status == RulesPageStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_state.Error?.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}
else if (_state.Snapshot is null)
{
    <MudPaper Class="pa-5" Elevation="1" role="status" aria-live="polite">
        <MudProgressLinear Indeterminate="true" Class="mb-3" aria-label="@(RulesText["LoadingStateAria"])" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @RulesText["LoadingAuthoritativeState"]
        </MudText>
    </MudPaper>
}
else if (_state.Snapshot is { })
{
    @if (_state.IsStale)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["DisplayedStateStale"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">@DescribeStaleState()</MudText>
            @if (_state.Error is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_state.Error.Message</MudText>
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@IsBusy"
                       OnClick="RefreshAsync">
                @RulesText["RefreshAuthoritative"]
            </MudButton>
        </MudAlert>
    }
    else if (_state.Status == RulesPageStatus.Refreshing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">
                @(_state.RefreshReason == RuleRefreshReason.AfterMutation
                    ? RulesText["RuleChangeAcceptedRefreshing"]
                    : RulesText["RefreshingAuthoritative"])
            </MudText>
        </MudAlert>
    }
    else if (_deleting)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5" role="status" aria-live="polite">
            <MudText Typo="Typo.body2">@RulesText["DeletingRule"]</MudText>
        </MudAlert>
    }

    <div class="rules-summary-grid">
        <MudPaper Elevation="1" Class="rules-summary-card rules-firewall-status-card" role="region" aria-labelledby="firewall-status-heading">
            <header>
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="@(_state.Snapshot.FirewallActive ? Color.Success : Color.Warning)" />
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">@RulesText["FirewallBreadcrumb"]</MudText>
                    <MudText Typo="Typo.h6" HtmlTag="h2" id="firewall-status-heading">
                        @(_state.Snapshot.FirewallActive ? CommonText["Active"] : CommonText["Inactive"])
                    </MudText>
                </div>
            </header>
            <div class="rules-firewall-status-meta">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@DescribeRuleCount(_state.Snapshot.Rules.Count)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@DescribeSnapshotStatus()</MudText>
            </div>
        </MudPaper>

        <MudPaper Elevation="1" Class="rules-summary-card rules-defaults-card" role="region" aria-labelledby="firewall-defaults-heading">
            <header>
                <MudText Typo="Typo.subtitle2" HtmlTag="h2" id="firewall-defaults-heading">@RulesText["FirewallDefaults"]</MudText>
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Filled"
                         Class="@(_state.Snapshot.Configuration.IPv6Enabled ? "page-status-chip page-status-chip-success" : "page-status-chip page-status-chip-warning")">
                    @(_state.Snapshot.Configuration.IPv6Enabled ? RulesText["IPv6CapabilityEnabled"] : RulesText["IPv6CapabilityDisabled"])
                </MudChip>
            </header>
            <div class="rules-default-policy-list">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @RulesText["DefaultIncoming"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.IncomingPolicy)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @RulesText["DefaultOutgoing"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.OutgoingPolicy)
                </MudChip>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                    @RulesText["DefaultRouted"]: @RuleText.FormatDefaultPolicy(_state.Snapshot.Configuration.RoutedPolicy)
                </MudChip>
            </div>
        </MudPaper>
    </div>

    @if (HasOrderingPreview)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5 rule-ordering-preview-alert" role="status" aria-live="polite">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">@RulesText["LocalOrderingPreview"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@RulesText["LocalOrderingPreviewDescription"]</MudText>
            <div class="mb-3">
                <MutationAuthorizationField @bind-Value="_orderingPrivateKey" Disabled="@_reordering" />
            </div>
            <footer>
                <MudButton Variant="Variant.Text" Disabled="@_reordering" OnClick="DiscardOrderingPreview">
                    @RulesText["DiscardPreview"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@_reordering"
                           OnClick="RefreshAsync">
                    @RulesText["ReloadAuthoritativeState"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(_reordering || string.IsNullOrWhiteSpace(_orderingPrivateKey))"
                           OnClick="ApplyOrderingPreviewAsync">
                    @(_reordering ? RulesText["ApplyingReordering"] : RulesText["ApplyReordering"])
                </MudButton>
            </footer>
        </MudAlert>
    }

    @if (_orderingResult is { } orderingResult)
    {
        <RuleOrderingResultAlert Result="@orderingResult.Response"
                                 BaselineRules="@orderingResult.BaselineRules"
                                 DesiredOrder="@orderingResult.DesiredOrder" />
    }

    <MudTabs ActivePanelIndex="@SelectedFamilyTabIndex"
             ActivePanelIndexChanged="SelectFamilyTab"
             KeepPanelsAlive="false"
             Class="rule-family-tabs"
             TabPanelsClass="rule-family-tab-panels">
        <MudTabPanel Text="@RuleText.FormatAddressFamily(FirewallAddressFamily.IPv4)" BadgeData="@IPv4Family.Rows.Count">
            <RuleFamilyWorkspace Family="@IPv4Family"
                                 QueryRows="@IPv4QueryRows"
                                 Query="@_ruleQuery"
                                 QueryActive="@_ruleQuery.IsActive"
                                 QueryChangesDisabled="@(!InteractionState.CanChangeQuery)"
                                 QueryChanged="ChangeQueryAsync"
                                 Loading="@(_state.Status == RulesPageStatus.Refreshing || _reordering)"
                                 Disabled="@(!CanMutateFirewall)"
                                 OrderingDisabled="@(!CanPreviewOrdering)"
                                 InsertionDisabled="@(!CanMutateFirewall)"
                                 MetadataEditDisabled="@(!CanEditMetadata)"
                                 MetadataEditRequested="EditMetadataAsync"
                                 DeleteRequested="BeginDeleteAsync"
                                 InsertionRequested="BeginOrderedInsertionAsync"
                                 MoveRequested="MoveRuleAsync" />
        </MudTabPanel>
        @if (IPv6FamilyAvailable)
        {
            <MudTabPanel Text="@RuleText.FormatAddressFamily(FirewallAddressFamily.IPv6)" BadgeData="@IPv6Family.Rows.Count">
                <RuleFamilyWorkspace Family="@IPv6Family"
                                     QueryRows="@IPv6QueryRows"
                                     Query="@_ruleQuery"
                                     QueryActive="@_ruleQuery.IsActive"
                                     QueryChangesDisabled="@(!InteractionState.CanChangeQuery)"
                                     QueryChanged="ChangeQueryAsync"
                                     Loading="@(_state.Status == RulesPageStatus.Refreshing || _reordering)"
                                     Disabled="@(!CanMutateFirewall)"
                                     OrderingDisabled="@(!CanPreviewOrdering)"
                                     InsertionDisabled="@(!CanMutateFirewall)"
                                     MetadataEditDisabled="@(!CanEditMetadata)"
                                     MetadataEditRequested="EditMetadataAsync"
                                     DeleteRequested="BeginDeleteAsync"
                                     InsertionRequested="BeginOrderedInsertionAsync"
                                     MoveRequested="MoveRuleAsync" />
            </MudTabPanel>
        }
    </MudTabs>
}
