@page "/"
@attribute [Authorize]
@inject IUfwApiClient UfwApiClient
@inject ISnackbar Snackbar

<PageTitle>Firewall rules - UFW Management</PageTitle>

<div class="d-flex flex-wrap align-center gap-3 mb-5">
    <div>
        <MudText Typo="Typo.h4">Firewall rules</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Rules reported by the privileged UFW daemon.
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading" OnClick="LoadAsync">
        Refresh
    </MudButton>
</div>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_loadError</MudAlert>
}

<MudPaper Class="pa-5 mb-6" Elevation="1">
    <div class="d-flex flex-wrap align-center gap-3 mb-4">
        <MudText Typo="Typo.h6">Add rule</MudText>
        <MudSpacer />
        <MudChip T="string" Color="@(_active ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
            @(_active ? "Firewall active" : "Firewall inactive")
        </MudChip>
    </div>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="FirewallAction" Label="Action" @bind-Value="_draft.Action" Disabled="_mutating">
                @foreach (FirewallAction value in Enum.GetValues<FirewallAction>())
                {
                    <MudSelectItem T="FirewallAction" Value="@value">@FormatEnum(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="FirewallDirection" Label="Direction" @bind-Value="_draft.Direction" Disabled="_mutating">
                @foreach (FirewallDirection value in Enum.GetValues<FirewallDirection>())
                {
                    <MudSelectItem T="FirewallDirection" Value="@value">@FormatEnum(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="FirewallProtocol" Label="Protocol" @bind-Value="_draft.Protocol" Disabled="_mutating">
                @foreach (FirewallProtocol value in Enum.GetValues<FirewallProtocol>())
                {
                    <MudSelectItem T="FirewallProtocol" Value="@value">@FormatEnum(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="FirewallAddressFamily" Label="Address family" @bind-Value="_draft.AddressFamily" Disabled="_mutating">
                @foreach (FirewallAddressFamily value in Enum.GetValues<FirewallAddressFamily>())
                {
                    <MudSelectItem T="FirewallAddressFamily" Value="@value">@FormatEnum(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" Label="Source" Placeholder="any or CIDR" @bind-Value="_draft.Source" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" Label="Destination" Placeholder="any or CIDR" @bind-Value="_draft.Destination" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" Label="Source ports" Placeholder="22,80:90" @bind-Value="_draft.SourcePorts" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string"
                          Label="Destination ports"
                          Placeholder="443"
                          @bind-Value="_draft.DestinationPorts"
                          Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" Label="Source interface" @bind-Value="_draft.SourceInterface" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" Label="Destination interface" @bind-Value="_draft.DestinationInterface" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Label="Comment" @bind-Value="_draft.Comment" Disabled="_mutating" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string"
                          Label="ECDSA P-256 private key (PKCS#8)"
                          InputType="InputType.Password"
                          @bind-Value="_addPrivateKey"
                          Disabled="_mutating"
                          HelperText="Used only to sign this add request. The key is not stored by the client."
                          Placeholder="PKCS#8 PEM or base64 DER"
                          Immediate="true" />
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@(_mutating || string.IsNullOrWhiteSpace(_addPrivateKey))"
                       OnClick="AddRuleAsync">
                Add signed rule
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_pendingDelete is not null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">Confirm rule deletion</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@DescribeRule(_pendingDelete)</MudText>
        <MudTextField T="string"
                      Label="ECDSA P-256 private key (PKCS#8)"
                      InputType="InputType.Password"
                      @bind-Value="_deletePrivateKey"
                      Disabled="_mutating"
                      HelperText="Used only to sign this delete request. The key is not stored by the client."
                      Immediate="true"
                      Class="mb-3" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="@(_mutating || string.IsNullOrWhiteSpace(_deletePrivateKey))"
                   OnClick="DeleteRuleAsync"
                   Class="mr-2">
            Delete signed rule
        </MudButton>
        <MudButton Variant="Variant.Text" Disabled="_mutating" OnClick="CancelDelete">Cancel</MudButton>
    </MudAlert>
}

<MudPaper Elevation="1">
    <MudTable T="ListedFirewallRule" Items="_rules" Loading="_loading" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Action</MudTh>
            <MudTh>Direction</MudTh>
            <MudTh>Protocol</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Destination</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (context.Parsed && context.Rule is not null)
            {
                <MudTd DataLabel="#">@(context.DisplayNumber?.ToString() ?? "-")</MudTd>
                <MudTd DataLabel="Action">@FormatEnum(context.Rule.Action)</MudTd>
                <MudTd DataLabel="Direction">@FormatEnum(context.Rule.Direction)</MudTd>
                <MudTd DataLabel="Protocol">@FormatEnum(context.Rule.Protocol)</MudTd>
                <MudTd DataLabel="Source">
                    @DescribeEndpoint(context.Rule.Source, context.Rule.SourcePorts, context.Rule.SourceInterface)
                </MudTd>
                <MudTd DataLabel="Destination">
                    @DescribeEndpoint(context.Rule.Destination, context.Rule.DestinationPorts, context.Rule.DestinationInterface)
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Disabled="@(_mutating || string.IsNullOrWhiteSpace(context.RuleId))"
                                   OnClick="@(() => BeginDelete(context))"
                                   aria-label="Delete rule" />
                </MudTd>
            }
            else
            {
                <MudTd DataLabel="#">@(context.DisplayNumber?.ToString() ?? "-")</MudTd>
                <MudTd colspan="5"><span class="rule-raw-line">@context.RawLine</span></MudTd>
                <MudTd>
                    <MudTooltip Text="This UFW line could not be parsed safely and cannot be mutated through the API.">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" />
                    </MudTooltip>
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No firewall rules were returned.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private IReadOnlyList<ListedFirewallRule> _rules = [];
    private FirewallRuleSpecification _draft = CreateDefaultRule();
    private ListedFirewallRule? _pendingDelete;
    private string _addPrivateKey = string.Empty;
    private string _deletePrivateKey = string.Empty;
    private string? _loadError;
    private bool _active;
    private bool _loading;
    private bool _mutating;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            Ufw.Ipc.Shared.Model.Responses.Domain.RuleListResponse response = await UfwApiClient.GetRulesAsync();
            _active = response.Active;
            _rules = response.Rules;
        }
        catch (Exception exception) when (exception is ApiRequestException or HttpRequestException or InvalidOperationException)
        {
            _loadError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_addPrivateKey))
        {
            return;
        }

        _mutating = true;
        try
        {
            await UfwApiClient.AddRuleAsync(_draft, _addPrivateKey);
            Snackbar.Add("Firewall rule added.", Severity.Success);
            _draft = CreateDefaultRule();
            await LoadAsync();
        }
        catch (Exception exception) when (IsMutationException(exception))
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _addPrivateKey = string.Empty;
            _mutating = false;
        }
    }

    private void BeginDelete(ListedFirewallRule rule)
    {
        _deletePrivateKey = string.Empty;
        _pendingDelete = rule;
    }

    private void CancelDelete()
    {
        _deletePrivateKey = string.Empty;
        _pendingDelete = null;
    }

    private async Task DeleteRuleAsync()
    {
        if (_pendingDelete is null || string.IsNullOrWhiteSpace(_deletePrivateKey))
        {
            return;
        }

        _mutating = true;
        try
        {
            await UfwApiClient.DeleteRuleAsync(_pendingDelete, _deletePrivateKey);
            Snackbar.Add("Firewall rule deleted.", Severity.Success);
            _pendingDelete = null;
            await LoadAsync();
        }
        catch (Exception exception) when (IsMutationException(exception))
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _deletePrivateKey = string.Empty;
            _mutating = false;
        }
    }

    private static FirewallRuleSpecification CreateDefaultRule() => new()
    {
        Action = FirewallAction.Allow,
        AddressFamily = FirewallAddressFamily.Any,
        Direction = FirewallDirection.In,
        Protocol = FirewallProtocol.Any,
        Source = RuleSpecificationNormalizer.ANY,
        Destination = RuleSpecificationNormalizer.ANY,
    };

    private static string DescribeRule(ListedFirewallRule listedRule)
    {
        if (listedRule.Rule is null)
        {
            return listedRule.RawLine;
        }

        FirewallRuleSpecification rule = listedRule.Rule;
        string source = DescribeEndpoint(rule.Source, rule.SourcePorts, rule.SourceInterface);
        string destination = DescribeEndpoint(rule.Destination, rule.DestinationPorts, rule.DestinationInterface);
        return $"{FormatEnum(rule.Action)} {FormatEnum(rule.Direction)} {FormatEnum(rule.Protocol)} from {source} to {destination}";
    }

    private static string DescribeEndpoint(string? address, string? ports, string? networkInterface)
    {
        string value = string.IsNullOrWhiteSpace(address) ? RuleSpecificationNormalizer.ANY : address;
        if (!string.IsNullOrWhiteSpace(ports))
        {
            value += $":{ports}";
        }
        if (!string.IsNullOrWhiteSpace(networkInterface))
        {
            value += $" via {networkInterface}";
        }
        return value;
    }

    private static bool IsMutationException(Exception exception) =>
        exception is ApiRequestException
            or HttpRequestException
            or InvalidOperationException
            or ArgumentException
            or Microsoft.JSInterop.JSException;

    private static string FormatEnum<T>(T value) where T : struct, Enum => value.ToString();
}
