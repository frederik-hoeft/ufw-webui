@page "/interfaces"
@attribute [Authorize]
@implements IDisposable
@inject INetworkInterfaceInventoryService InterfaceInventory
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<InterfacesStrings> InterfacesText

<PageTitle>@InterfacesText["PageTitle"] - UFW Console</PageTitle>

<PageHeader Title="@(InterfacesText["Title"])"
            Description="@(InterfacesText["Description"])"
            Breadcrumbs="@Breadcrumbs"
            ShowStatus="@(_inventory is not null)">
    <Actions>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync"
                   Class="page-header-button">
            @InterfacesText["RefreshCacheView"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@IsBusy"
                   OnClick="ReconcileAsync"
                   Class="page-header-button">
            @InterfacesText["ReconcileFromDaemon"]
        </MudButton>
    </Actions>
    <Status>
        @if (_inventory is not null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @DescribeCount(_inventory.Interfaces.Count)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="page-status-chip">
                @(_inventory.ReconciledAt is { } reconciledAt
                    ? InterfacesText["ReconciledAt", FormatLocalDateTime(reconciledAt)]
                    : InterfacesText["NotReconciledYet"])
            </MudChip>
        }
    </Status>
</PageHeader>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-5" role="alert">
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@InterfacesText["LoadFailed"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">@_error.Message</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@IsBusy"
                   OnClick="RefreshAsync">
            @CommonText["Retry"]
        </MudButton>
    </MudAlert>
}

<MudPaper Class="interface-inventory-card" Elevation="1">
    <div class="interface-inventory-heading">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@InterfacesText["CachedInventoryTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @InterfacesText["CachedInventoryDescription"]
            </MudText>
        </div>
    </div>

    @if (_loading && _inventory is null)
    {
        <div class="interface-inventory-loading" role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" aria-label="@(InterfacesText["LoadingAria"])" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@InterfacesText["LoadingInventory"]</MudText>
        </div>
    }
    else if (_inventory is { Interfaces.Count: 0 })
    {
        <div class="interface-inventory-empty">
            <MudIcon Icon="@Icons.Material.Filled.Lan" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.subtitle1">@InterfacesText["NoKnownInterfaces"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @InterfacesText["NoKnownInterfacesDescription"]
            </MudText>
        </div>
    }
    else if (_inventory is not null)
    {
        <MudTable T="NetworkInterfaceInventoryItem"
                  Items="@_inventory.Interfaces"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Class="interface-inventory-table interface-inventory-desktop">
            <HeaderContent>
                <MudTh>@InterfacesText["InterfaceColumn"]</MudTh>
                <MudTh>@InterfacesText["CommentColumn"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@(InterfacesText["InterfaceColumn"])">
                    <code class="interface-name">@context.Name</code>
                </MudTd>
                <MudTd DataLabel="@(InterfacesText["CommentColumn"])">
                    <div class="interface-comment-cell">
                        <span class="@(string.IsNullOrWhiteSpace(context.Comment) ? "interface-comment-empty" : "interface-comment")">
                            @(string.IsNullOrWhiteSpace(context.Comment) ? InterfacesText["NoComment"] : context.Comment)
                        </span>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   Disabled="@IsBusy"
                                   OnClick="@(() => EditCommentAsync(context))">
                            @InterfacesText["EditComment"]
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>

        <div class="interface-inventory-mobile">
            @foreach (NetworkInterfaceInventoryItem item in _inventory.Interfaces)
            {
                <div class="interface-mobile-row">
                    <div class="interface-mobile-copy">
                        <code class="interface-name">@item.Name</code>
                        <span class="@(string.IsNullOrWhiteSpace(item.Comment) ? "interface-comment-empty" : "interface-comment")">
                            @(string.IsNullOrWhiteSpace(item.Comment) ? InterfacesText["NoComment"] : item.Comment)
                        </span>
                    </div>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Disabled="@IsBusy"
                               OnClick="@(() => EditCommentAsync(item))">
                        @InterfacesText["EditComment"]
                    </MudButton>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    private static readonly DialogOptions s_commentDialogOptions = new()
    {
        BackdropClick = false,
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Small,
    };

    private readonly CancellationTokenSource _lifetime = new();
    private NetworkInterfaceInventoryResponse? _inventory;
    private ClientError? _error;
    private bool _loading;
    private bool _savingComment;

    private IReadOnlyList<BreadcrumbItem> Breadcrumbs =>
    [
        new BreadcrumbItem(InterfacesText["HostBreadcrumb"], null, disabled: true),
        new BreadcrumbItem(InterfacesText["InterfacesBreadcrumb"], null, disabled: true),
    ];

    private bool IsBusy => _loading || _savingComment;

    protected override Task OnInitializedAsync() => RefreshAsync();

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task RefreshAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _inventory = await InterfaceInventory.RefreshAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (ClientErrors.TryDescribe(exception, out _))
        {
            _error = ClientErrors.Describe(exception);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReconcileAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _inventory = await InterfaceInventory.ReconcileAsync(_lifetime.Token);
            Snackbar.Add(InterfacesText["ReconciledFromDaemon"], Severity.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (ClientErrors.TryDescribe(exception, out _))
        {
            _error = ClientErrors.Describe(exception);
            Snackbar.Add(_error.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EditCommentAsync(NetworkInterfaceInventoryItem item)
    {
        if (IsBusy)
        {
            return;
        }

        DialogParameters<EditNetworkInterfaceCommentDialog> parameters = new();
        parameters.Add(component => component.InterfaceName, item.Name);
        parameters.Add(component => component.Comment, item.Comment);
        IDialogReference dialog = await DialogService.ShowAsync<EditNetworkInterfaceCommentDialog>(
            InterfacesText["EditCommentTitle"],
            parameters,
            s_commentDialogOptions);
        string? comment = await dialog.GetReturnValueAsync<string>();
        if (comment is null)
        {
            return;
        }

        _savingComment = true;
        try
        {
            _inventory = await InterfaceInventory.UpdateCommentAsync(item.Id, comment, _lifetime.Token);
            Snackbar.Add(InterfacesText["CommentSaved"], Severity.Success);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (ClientErrors.TryDescribe(exception, out _))
        {
            _error = ClientErrors.Describe(exception);
            Snackbar.Add(_error.Message, Severity.Error);
        }
        finally
        {
            _savingComment = false;
        }
    }

    private string DescribeCount(int count) => count == 1
        ? InterfacesText["KnownInterfaceCountOne"]
        : InterfacesText["KnownInterfaceCountMany", count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)];

    private static string FormatLocalDateTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture);
}
