@page "/login"
@layout LoginLayout
@implements IDisposable
@inject IAuthenticationService AuthenticationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<AuthenticationStrings> AuthenticationText

<PageTitle>@AuthenticationText["PageTitle"] - UFW Console</PageTitle>

<StandalonePanel Title="@(AuthenticationText["Title"])"
                 Description="@(AuthenticationText["Description"])"
                 Class="login-card">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-4" role="alert">
            @_error
        </MudAlert>
    }

    <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="LoginAsync" aria-busy="@_busy">
        <MudTextField T="string"
                      Label="@(AuthenticationText["Email"])"
                      InputType="InputType.Email"
                      InputMode="InputMode.email"
                      @bind-Value="_email"
                      Validation="@EmailValidation"
                      Required="true"
                      autocomplete="username"
                      autocapitalize="off"
                      spellcheck="false"
                      RequiredError="@(AuthenticationText["EmailRequired"])"
                      Disabled="_busy"
                      Immediate="true"
                      Class="mb-3" />
        <MudTextField T="string"
                      Label="@(AuthenticationText["Password"])"
                      InputType="InputType.Password"
                      @bind-Value="_password"
                      Required="true"
                      autocomplete="current-password"
                      autocapitalize="off"
                      spellcheck="false"
                      RequiredError="@(AuthenticationText["PasswordRequired"])"
                      Disabled="_busy"
                      Immediate="true" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Disabled="@(_busy || !_isValid)"
                   OnClick="LoginAsync"
                   StartIcon="@Icons.Material.Filled.Login"
                   Class="mt-6">
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            @(_busy ? AuthenticationText["SigningIn"] : AuthenticationText["SignIn"])
        </MudButton>
    </MudForm>
</StandalonePanel>

@code {
    private Func<string?, string?> EmailValidation => value =>
        new EmailAddressAttribute().IsValid(value) ? null : AuthenticationText["EmailInvalid"].Value;

    private readonly CancellationTokenSource _lifetime = new();
    private MudForm? _form;
    private bool _isValid;
    private bool _busy;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigateAfterLogin();
        }
    }

    public void Dispose()
    {
        _password = string.Empty;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private async Task LoginAsync()
    {
        if (_busy || _form is null)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }

            await AuthenticationService.LoginAsync(_email, _password, _lifetime.Token);
            _password = string.Empty;
            NavigateAfterLogin();
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (ApiRequestException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        {
            _error = AuthenticationText["InvalidCredentials"];
        }
        catch (Exception exception) when (ClientErrors.TryDescribe(exception, out _))
        {
            _error = ClientErrors.Describe(exception).Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void NavigateAfterLogin()
    {
        string target = IsLocalReturnUrl(ReturnUrl) ? ReturnUrl! : "/rules";
        Navigation.NavigateTo(target, replace: true);
    }

    private static bool IsLocalReturnUrl(string? returnUrl)
    {
        return returnUrl is { Length: > 0 }
            && returnUrl[0] == '/'
            && (returnUrl.Length == 1 || (returnUrl[1] != '/' && returnUrl[1] != '\\'));
    }
}
