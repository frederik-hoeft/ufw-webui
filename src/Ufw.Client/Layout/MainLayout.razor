@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthenticationService AuthenticationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IClientErrorMapper ClientErrors
@inject IStringLocalizer<CommonStrings> CommonText

<a class="skip-link" href="#main-content">@CommonText["SkipToMainContent"]</a>

<CascadingValue Value="@_pageChrome" IsFixed="true">
<MudLayout>
    <MudAppBar Fixed="true" Elevation="0" Class="app-shell-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       Class="appbar-menu-button"
                       aria-label="@(CommonText["ToggleNavigation"])" />
        @if (_pageChrome.Breadcrumbs.Count > 0)
        {
            <div class="appbar-navigation-context">
                <MudBreadcrumbs Items="@_pageChrome.Breadcrumbs" Separator="/" Class="appbar-breadcrumbs" />
            </div>
        }
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <AppUserMenu UserName="@(context.User.Identity?.Name ?? string.Empty)"
                             SignOutBusy="@_logoutBusy"
                             SignOut="LogoutAsync" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Sm"
               ClipMode="DrawerClipMode.Never"
               Elevation="0"
               Class="app-shell-drawer">
        <PrimaryNavigation />
    </MudDrawer>

    <MudMainContent Class="app-main-content">
        <main id="main-content" tabindex="-1" class="app-main">
            <MudContainer MaxWidth="MaxWidth.False" Class="main-container">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>
</CascadingValue>
