@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<InterfacesStrings> InterfacesText

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @InterfacesText["EditCommentDescription", InterfaceName]
        </MudText>
        <MudTextField T="string"
                      Label="@(InterfacesText["CommentColumn"])"
                      @bind-Value="_comment"
                      Immediate="true"
                      Counter="200"
                      MaxLength="200"
                      autofocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@CommonText["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">
            @InterfacesText["SaveComment"]
        </MudButton>
    </DialogActions>
</MudDialog>
