@using Ufw.Client.Errors
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<StandaloneStrings> StandaloneText
@inject IStringLocalizer<ErrorsStrings> ErrorsText

<main class="standalone-shell">
    <StandalonePanel Title="@(StandaloneText["UnableToInitialize"])"
                     Description="@Error.Message"
                     Icon="@Icons.Material.Filled.CloudOff"
                     IconColor="Color.Error"
                     Class="standalone-state-card"
                     Role="alert">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(Error.DiagnosticReference))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="error-diagnostic-reference">
                    @ErrorsText["DiagnosticReference", Error.DiagnosticReference]
                </MudText>
            }
        </ChildContent>
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="Busy"
                       OnClick="OnRetry"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @if (Busy)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                }
                @(Busy ? CommonText["Retrying"] : CommonText["Retry"])
            </MudButton>
        </Actions>
    </StandalonePanel>
</main>

@code {
    [Parameter, EditorRequired]
    public ClientError Error { get; set; } = null!;

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
