@using Ufw.Client.Errors
@inject NavigationManager Navigation

<main class="unexpected-error-shell">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
        <MudPaper Class="pa-6" Elevation="1" role="alert">
            <MudText Typo="Typo.h5" HtmlTag="h1" GutterBottom="true">Something went wrong</MudText>
            <MudText Typo="Typo.body1" Class="mb-5">@Error.Message</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">
                Reload application
            </MudButton>
        </MudPaper>
    </MudContainer>
</main>

@code {
    [Parameter, EditorRequired]
    public ClientError Error { get; set; } = null!;

    private void Reload() => Navigation.Refresh(forceReload: true);
}
