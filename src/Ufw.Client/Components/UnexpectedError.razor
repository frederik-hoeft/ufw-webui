@using Ufw.Client.Errors
@inject NavigationManager Navigation
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<StandaloneStrings> StandaloneText
@inject IStringLocalizer<ErrorsStrings> ErrorsText

<main class="standalone-shell">
    <ThemeToggle Class="standalone-theme-toggle" />
    <StandalonePanel Title="@(StandaloneText["SomethingWentWrong"])"
                     Description="@Error.Message"
                     Icon="@Icons.Material.Filled.ErrorOutline"
                     IconColor="Color.Error"
                     Class="standalone-state-card"
                     Role="alert">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(Error.DiagnosticReference))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="error-diagnostic-reference">
                    @ErrorsText["DiagnosticReference", Error.DiagnosticReference]
                </MudText>
            }
        </ChildContent>
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Reload"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @CommonText["ReloadApplication"]
            </MudButton>
        </Actions>
    </StandalonePanel>
</main>
