<div class="@CssClass">
    <img class="app-brand-mark" src="brand/cleaned-close-3-app-icon.svg" alt="" aria-hidden="true" />
    <MudText Typo="Typo.subtitle1" HtmlTag="span" Class="app-brand-name">UFW Console</MudText>
</div>

@code {
    [Parameter]
    public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "app-brand" : $"app-brand {Class}";
}
