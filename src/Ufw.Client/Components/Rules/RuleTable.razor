@inject IDialogService DialogService
@inject IFirewallRuleText RuleText
@inject IStringLocalizer<RulesStrings> RulesText

<section aria-labelledby="firewall-rule-list-heading" class="rule-list-section">
    <h2 id="firewall-rule-list-heading" class="visually-hidden">@RulesText["CurrentFirewallRules"]</h2>
    <MudPaper Elevation="0" Class="rule-table-card">
        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Class="rule-table-progress"
                               aria-label="@(RulesText["LoadingStateAria"])" />
        }

        @if (Rules.Count == 0)
        {
            <div class="rule-empty-state">
                <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle1">@RulesText["NoFirewallRules"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @RulesText["NoFirewallRulesDescription"]
                </MudText>
                <MudButton Href="/rules/create"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@Disabled"
                           Class="mt-2">
                    @RulesText["AddRule"]
                </MudButton>
            </div>
        }
        else
        {
            <div class="rule-table-scroll" tabindex="0" role="region" aria-label="@(RulesText["TableAria"])">
                <table class="rule-table" aria-busy="@Loading">
                    <thead>
                        <tr>
                            <th scope="col" class="rule-drag-column"><span class="visually-hidden">@RulesText["ReorderColumn"]</span></th>
                            <th scope="col" class="rule-number-column"><span aria-hidden="true">#</span><span class="visually-hidden">@RulesText["RuleNumber"]</span></th>
                            <th scope="col" class="rule-action-column">@RulesText["ActionColumn"]</th>
                            <th scope="col" class="rule-direction-column">@RulesText["DirectionColumn"]</th>
                            <th scope="col" class="rule-endpoint-column">@RulesText["FromColumn"]</th>
                            <th scope="col" class="rule-endpoint-column">@RulesText["ToColumn"]</th>
                            <th scope="col" class="rule-protocol-column">@RulesText["ProtocolColumn"]</th>
                            <th scope="col" class="rule-comment-column">@RulesText["CommentColumn"]</th>
                            <th scope="col" class="rule-row-actions"><span class="visually-hidden">@RulesText["ActionsColumn"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ListedFirewallRule rule in Rules)
                        {
                            if (rule.Parsed && rule.Rule is not null)
                            {
                                <tr class="@RowClass(rule)"
                                    @ondragenter="@(() => SetDragTarget(rule))"
                                    @ondragover="@(() => SetDragTarget(rule))"
                                    @ondragover:preventDefault
                                    @ondrop="@(() => DropAsync(rule))">
                                    <td class="rule-drag-column">
                                        <button type="button"
                                                class="@DragHandleClass(rule)"
                                                draggable="@DragEnabled(rule)"
                                                disabled="@(OrderingDisabled || !CanOrderRule(rule))"
                                                title="@DragHandleTitle(rule)"
                                                aria-label="@DragHandleLabel(rule)"
                                                @ondragstart="@(() => BeginDrag(rule))"
                                                @ondragend="EndDrag">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                        </button>
                                    </td>
                                    <td class="rule-number-column">
                                        @if (TryGetPositionChange(rule, out int originalPosition, out int currentPosition, out bool directlyMoved))
                                        {
                                            <span class="@PositionChangeClass(directlyMoved)"
                                                  aria-label="@PositionChangeLabel(originalPosition, currentPosition, directlyMoved)">
                                                <span aria-hidden="true" class="rule-position-change-values">
                                                    @if (directlyMoved)
                                                    {
                                                        <s>@originalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</s>
                                                    }
                                                    else
                                                    {
                                                        <span>@originalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                                                    }
                                                    <span class="rule-position-arrow">&rarr;</span>
                                                    <span>@currentPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rule-number">@(rule.DisplayNumber?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "-")</span>
                                        }
                                    </td>
                                    <td class="rule-action-column">
                                        <span class="@FirewallRulePresentation.ActionClass(rule.Rule.Action)">
                                            @RuleText.FormatAction(rule.Rule.Action)
                                        </span>
                                    </td>
                                    <td class="rule-direction-column">
                                        <span class="rule-direction-family">
                                            <span class="rule-direction">@RuleText.FormatDirection(rule.Rule.Direction)</span>
                                            <span class="rule-family">@RuleText.FormatAddressFamily(rule.Rule.AddressFamily)</span>
                                        </span>
                                    </td>
                                    <td class="rule-endpoint-column">
                                        <span class="rule-endpoint">
                                            @RuleText.DescribeEndpoint(rule.Rule.Source, rule.Rule.SourcePorts, rule.Rule.SourceInterface)
                                        </span>
                                    </td>
                                    <td class="rule-endpoint-column">
                                        <span class="rule-endpoint">
                                            @RuleText.DescribeEndpoint(rule.Rule.Destination, rule.Rule.DestinationPorts, rule.Rule.DestinationInterface)
                                        </span>
                                    </td>
                                    <td class="rule-protocol-column">
                                        <span class="rule-protocol">@RuleText.FormatProtocol(rule.Rule.Protocol)</span>
                                    </td>
                                    <td class="rule-comment-column">
                                        @if (!string.IsNullOrWhiteSpace(rule.Rule.Comment))
                                        {
                                            <span class="rule-comment">@rule.Rule.Comment</span>
                                        }
                                        else
                                        {
                                            <span class="rule-comment-empty">@RulesText["None"]</span>
                                        }
                                    </td>
                                    <td class="rule-row-actions">
                                        <RuleActionsMenu Rule="@rule"
                                                         OrderingDisabled="@OrderingDisabled"
                                                         InsertionDisabled="@InsertionDisabled"
                                                         MutationDisabled="@Disabled"
                                                         CanOrder="@CanOrderRule(rule)"
                                                         CanMutate="@CanMutateRule(rule)"
                                                         MoveToPositionRequested="@RequestMoveToPositionAsync"
                                                         DeleteRequested="@DeleteRequested" />
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="@ReadOnlyRowClass(rule)"
                                    @ondragenter="@(() => SetDragTarget(rule))"
                                    @ondragover="@(() => SetDragTarget(rule))"
                                    @ondragover:preventDefault
                                    @ondrop="@(() => DropAsync(rule))">
                                    <td class="rule-drag-column">
                                        <span class="rule-drag-handle rule-drag-handle-disabled" aria-hidden="true">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                        </span>
                                    </td>
                                    <td class="rule-number-column">
                                        <span class="rule-number">@(rule.DisplayNumber?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "-")</span>
                                    </td>
                                    <td colspan="6">
                                        <div class="rule-unsupported">
                                            <span class="rule-unsupported-label">@RulesText["ReadOnly"]</span>
                                            <span class="rule-raw-line">@rule.RawLine</span>
                                        </div>
                                    </td>
                                    <td class="rule-row-actions">
                                        <MudTooltip Text="@(RulesText["ReadOnlyTooltip"])">
                                            <span role="img" aria-label="@(RulesText["ReadOnlyAria"])">
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                            </span>
                                        </MudTooltip>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="rule-mobile-list" aria-busy="@Loading">
                @foreach (ListedFirewallRule rule in Rules)
                {
                    if (rule.Parsed && rule.Rule is not null)
                    {
                        <article class="@MobileCardClass(rule)"
                                 @ondragenter="@(() => SetDragTarget(rule))"
                                 @ondragover="@(() => SetDragTarget(rule))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => DropAsync(rule))">
                            <div class="rule-mobile-card-header">
                                <div class="rule-mobile-card-leading">
                                    <button type="button"
                                            class="@DragHandleClass(rule)"
                                            draggable="@DragEnabled(rule)"
                                            disabled="@(OrderingDisabled || !CanOrderRule(rule))"
                                            title="@DragHandleTitle(rule)"
                                            aria-label="@DragHandleLabel(rule)"
                                            @ondragstart="@(() => BeginDrag(rule))"
                                            @ondragend="EndDrag">
                                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    </button>
                                    <div class="rule-mobile-card-identity">
                                        @if (TryGetPositionChange(rule, out int originalPosition, out int currentPosition, out bool directlyMoved))
                                        {
                                            <span class="@PositionChangeClass(directlyMoved)"
                                                  aria-label="@PositionChangeLabel(originalPosition, currentPosition, directlyMoved)">
                                                <span aria-hidden="true" class="rule-position-change-values">
                                                    @if (directlyMoved)
                                                    {
                                                        <s>@originalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</s>
                                                    }
                                                    else
                                                    {
                                                        <span>@originalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                                                    }
                                                    <span class="rule-position-arrow">&rarr;</span>
                                                    <span>@currentPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rule-number">#@(rule.DisplayNumber?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "-")</span>
                                        }
                                        <span class="@FirewallRulePresentation.ActionClass(rule.Rule.Action)">
                                            @RuleText.FormatAction(rule.Rule.Action)
                                        </span>
                                    </div>
                                </div>
                                <RuleActionsMenu Rule="@rule"
                                                 OrderingDisabled="@OrderingDisabled"
                                                 InsertionDisabled="@InsertionDisabled"
                                                 MutationDisabled="@Disabled"
                                                 CanOrder="@CanOrderRule(rule)"
                                                 CanMutate="@CanMutateRule(rule)"
                                                 MoveToPositionRequested="@RequestMoveToPositionAsync"
                                                 DeleteRequested="@DeleteRequested" />
                            </div>

                            <div class="rule-mobile-card-details">
                                <div>
                                    <span class="rule-mobile-field-label">@RulesText["DirectionColumn"]</span>
                                    <span class="rule-direction-family">
                                        <span class="rule-direction">@RuleText.FormatDirection(rule.Rule.Direction)</span>
                                        <span class="rule-family">@RuleText.FormatAddressFamily(rule.Rule.AddressFamily)</span>
                                    </span>
                                </div>
                                <div>
                                    <span class="rule-mobile-field-label">@RulesText["ProtocolColumn"]</span>
                                    <span class="rule-protocol">@RuleText.FormatProtocol(rule.Rule.Protocol)</span>
                                </div>
                            </div>

                            <dl class="rule-mobile-endpoints">
                                <div>
                                    <dt>@RulesText["FromColumn"]</dt>
                                    <dd class="rule-endpoint">@RuleText.DescribeEndpoint(rule.Rule.Source, rule.Rule.SourcePorts, rule.Rule.SourceInterface)</dd>
                                </div>
                                <div>
                                    <dt>@RulesText["ToColumn"]</dt>
                                    <dd class="rule-endpoint">@RuleText.DescribeEndpoint(rule.Rule.Destination, rule.Rule.DestinationPorts, rule.Rule.DestinationInterface)</dd>
                                </div>
                            </dl>

                            @if (!string.IsNullOrWhiteSpace(rule.Rule.Comment))
                            {
                                <div class="rule-mobile-comment">
                                    <span class="rule-mobile-field-label">@RulesText["CommentColumn"]</span>
                                    <span class="rule-comment">@rule.Rule.Comment</span>
                                </div>
                            }
                        </article>
                    }
                    else
                    {
                        <article class="@ReadOnlyMobileCardClass(rule)"
                                 @ondragenter="@(() => SetDragTarget(rule))"
                                 @ondragover="@(() => SetDragTarget(rule))"
                                 @ondragover:preventDefault
                                 @ondrop="@(() => DropAsync(rule))">
                            <div class="rule-mobile-card-header">
                                <span class="rule-number">#@(rule.DisplayNumber?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "-")</span>
                                <MudTooltip Text="@(RulesText["ReadOnlyTooltip"])">
                                    <span role="img" aria-label="@(RulesText["ReadOnlyAria"])">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                                    </span>
                                </MudTooltip>
                            </div>
                            <span class="rule-unsupported-label">@RulesText["ReadOnly"]</span>
                            <span class="rule-raw-line">@rule.RawLine</span>
                        </article>
                    }
                }
            </div>
        }
    </MudPaper>

    @if (Rules.Count > 0)
    {
        <div class="rule-ordering-note" role="note">
            <strong>@RulesText["OrderingLabel"]</strong>
            <span>@RulesText["OrderingDescription"]</span>
        </div>
    }
</section>
