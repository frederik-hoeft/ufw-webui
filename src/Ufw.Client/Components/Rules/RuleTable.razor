@inject IDialogService DialogService

<section aria-labelledby="firewall-rule-list-heading" class="rule-list-section">
    <h2 id="firewall-rule-list-heading" class="visually-hidden">Current firewall rules</h2>
    <MudPaper Elevation="0" Class="rule-table-card">
        <MudTable T="ListedFirewallRule"
                  Items="@Rules"
                  Loading="@Loading"
                  Hover="true"
                  Breakpoint="Breakpoint.Md"
                  Class="rule-table">
            <HeaderContent>
                <MudTh Class="rule-drag-column"><span class="visually-hidden">Reorder</span></MudTh>
                <MudTh><span aria-hidden="true">#</span><span class="visually-hidden">Rule number</span></MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Direction</MudTh>
                <MudTh>From</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Protocol</MudTh>
                <MudTh>Comment</MudTh>
                <MudTh><span class="visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (context.Parsed && context.Rule is not null)
                {
                    <MudTd Class="rule-drag-column" DataLabel="Reorder">
                        <button type="button"
                                class="@DragHandleClass(context)"
                                draggable="@(!OrderingDisabled && CanOrderRule(context))"
                                disabled="@(OrderingDisabled || !CanOrderRule(context))"
                                title="@DragHandleTitle(context)"
                                aria-label="@DragHandleLabel(context)"
                                @ondragstart="@(() => BeginDrag(context))"
                                @ondragenter="@(() => SetDragTarget(context))"
                                @ondragleave="@(() => ClearDragTarget(context))"
                                @ondragover:preventDefault
                                @ondrop="@(() => DropAsync(context))"
                                @ondragend="EndDrag">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                        </button>
                    </MudTd>
                    <MudTd DataLabel="Rule number">
                        <span class="rule-number">@(context.DisplayNumber?.ToString() ?? "-")</span>
                    </MudTd>
                    <MudTd DataLabel="Action">
                        <span class="@FirewallRulePresentation.ActionClass(context.Rule.Action)">
                            @FirewallRulePresentation.FormatEnum(context.Rule.Action)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Direction">
                        <span class="rule-direction">@FirewallRulePresentation.FormatEnum(context.Rule.Direction)</span>
                        <span class="rule-family">@FirewallRulePresentation.FormatAddressFamily(context.Rule.AddressFamily)</span>
                    </MudTd>
                    <MudTd DataLabel="From">
                        <span class="rule-endpoint">
                            @FirewallRulePresentation.DescribeEndpoint(context.Rule.Source, null, context.Rule.SourceInterface)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="To">
                        <span class="rule-endpoint">
                            @FirewallRulePresentation.DescribeEndpoint(context.Rule.Destination, null, context.Rule.DestinationInterface)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Protocol">
                        <span class="rule-protocol">@FirewallRulePresentation.FormatProtocol(context.Rule.Protocol)</span>
                        @if (FirewallRulePresentation.DescribePorts(context.Rule) is { } portDescription)
                        {
                            <span class="rule-protocol-detail">@portDescription</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Comment">
                        @if (!string.IsNullOrWhiteSpace(context.Rule.Comment))
                        {
                            <span class="rule-comment">@context.Rule.Comment</span>
                        }
                        else
                        {
                            <span class="rule-comment-empty">None</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="rule-row-actions">
                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
                                 Size="Size.Small"
                                 Dense="true"
                                 Class="rule-row-menu"
                                 aria-label="@ActionsLabel(context)">
                            <MudMenuItem Disabled="@(OrderingDisabled || !CanOrderRule(context))"
                                         OnClick="@(() => RequestMoveToPositionAsync(context))">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="mr-2" />
                                Move to position...
                            </MudMenuItem>
                            <MudMenuItem Disabled="@(InsertionDisabled || !CanOrderRule(context))"
                                         Href="@BuildInsertBeforeHref(context)">
                                <MudIcon Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" Class="mr-2" />
                                Insert before
                            </MudMenuItem>
                            <MudMenuItem Disabled="@(InsertionDisabled || !CanOrderRule(context))"
                                         Href="@BuildInsertAfterHref(context)">
                                <MudIcon Icon="@Icons.Material.Filled.VerticalAlignBottom" Size="Size.Small" Class="mr-2" />
                                Insert after
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Disabled="@(Disabled || !CanMutateRule(context))"
                                         OnClick="@(() => DeleteRequested.InvokeAsync(context))"
                                         Class="rule-menu-delete">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" />
                                Delete rule
                            </MudMenuItem>
                        </MudMenu>
                    </MudTd>
                }
                else
                {
                    <MudTd Class="rule-drag-column" DataLabel="Reorder">
                        <span class="rule-drag-handle rule-drag-handle-disabled" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Rule number">
                        <span class="rule-number">@(context.DisplayNumber?.ToString() ?? "-")</span>
                    </MudTd>
                    <MudTd colspan="6">
                        <div class="rule-unsupported">
                            <span class="rule-unsupported-label">Read only</span>
                            <span class="rule-raw-line">@context.RawLine</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="rule-row-actions">
                        <MudTooltip Text="This UFW line could not be parsed safely and cannot be mutated through the API.">
                            <span role="img" aria-label="Rule is read-only because it could not be parsed safely">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                            </span>
                        </MudTooltip>
                    </MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <div class="rule-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">No firewall rules</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        The authoritative UFW rule list is empty.
                    </MudText>
                    <MudButton Href="/rules/create"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@Disabled"
                               Class="mt-2">
                        Add rule
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    @if (Rules.Count > 0)
    {
        <div class="rule-ordering-note" role="note">
            <strong>Ordering</strong>
            <span>
                Drag a rule by its handle or use "Move to position..." for an explicit keyboard-friendly flow.
                Insert-before/after actions open rule creation with the selected position context.
            </span>
            @if (OrderingUsesMockData)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="rule-ordering-mock-chip">
                    Mock API
                </MudChip>
            }
        </div>
    }
</section>

@code {
    private static readonly DialogOptions s_moveDialogOptions = new()
    {
        BackdropClick = false,
        CloseButton = true,
        CloseOnEscapeKey = true,
        DefaultFocus = DefaultFocus.FirstChild,
        FullWidth = true,
        MaxWidth = MaxWidth.ExtraSmall,
    };

    private ListedFirewallRule? _draggedRule;
    private ListedFirewallRule? _dragTargetRule;

    [Parameter]
    public IReadOnlyList<ListedFirewallRule> Rules { get; set; } = [];

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool OrderingDisabled { get; set; }

    [Parameter]
    public bool InsertionDisabled { get; set; }

    [Parameter]
    public bool OrderingUsesMockData { get; set; }

    [Parameter]
    public EventCallback<ListedFirewallRule> DeleteRequested { get; set; }

    [Parameter]
    public EventCallback<RuleMoveRequest> MoveRequested { get; set; }

    private static string ActionsLabel(ListedFirewallRule rule)
        => rule.DisplayNumber is { } number ? $"Actions for firewall rule {number}" : "Firewall rule actions";

    private static string DragHandleLabel(ListedFirewallRule rule)
        => rule.DisplayNumber is { } number ? $"Drag firewall rule {number} to reorder" : "Drag firewall rule to reorder";

    private string DragHandleTitle(ListedFirewallRule rule)
    {
        if (!CanOrderRule(rule))
        {
            return "This rule cannot be addressed unambiguously for ordering.";
        }

        return OrderingUsesMockData
            ? "Drag to preview a new order. The mock does not change UFW."
            : "Drag to reorder this firewall rule.";
    }

    private string DragHandleClass(ListedFirewallRule rule)
    {
        List<string> classes = ["rule-drag-handle"];
        if (OrderingDisabled || !CanOrderRule(rule))
        {
            classes.Add("rule-drag-handle-disabled");
        }

        if (ReferenceEquals(_dragTargetRule, rule) && !ReferenceEquals(_draggedRule, rule))
        {
            classes.Add("rule-drag-handle-target");
        }

        return string.Join(' ', classes);
    }

    private bool CanOrderRule(ListedFirewallRule rule) => CanMutateRule(rule);

    private bool CanMutateRule(ListedFirewallRule rule)
    {
        if (!rule.Parsed || rule.Rule is null || string.IsNullOrWhiteSpace(rule.RuleId))
        {
            return false;
        }

        int matches = 0;
        foreach (ListedFirewallRule candidate in Rules)
        {
            if (string.Equals(candidate.RuleId, rule.RuleId, StringComparison.Ordinal) && ++matches > 1)
            {
                return false;
            }
        }

        return matches == 1;
    }

    private void BeginDrag(ListedFirewallRule rule)
    {
        if (!OrderingDisabled && CanOrderRule(rule))
        {
            _draggedRule = rule;
        }
    }

    private void SetDragTarget(ListedFirewallRule rule)
    {
        if (_draggedRule is not null && CanOrderRule(rule))
        {
            _dragTargetRule = rule;
        }
    }

    private void ClearDragTarget(ListedFirewallRule rule)
    {
        if (ReferenceEquals(_dragTargetRule, rule))
        {
            _dragTargetRule = null;
        }
    }

    private void EndDrag()
    {
        _draggedRule = null;
        _dragTargetRule = null;
    }

    private async Task DropAsync(ListedFirewallRule target)
    {
        ListedFirewallRule? source = _draggedRule;
        try
        {
            if (source is null || ReferenceEquals(source, target) || OrderingDisabled)
            {
                return;
            }

            int targetPosition = PositionOf(target);
            if (targetPosition > 0 && !string.IsNullOrWhiteSpace(source.RuleId))
            {
                await MoveRequested.InvokeAsync(new RuleMoveRequest(source.RuleId, targetPosition));
            }
        }
        finally
        {
            EndDrag();
        }
    }

    private async Task RequestMoveToPositionAsync(ListedFirewallRule rule)
    {
        if (OrderingDisabled || !CanOrderRule(rule) || string.IsNullOrWhiteSpace(rule.RuleId))
        {
            return;
        }

        int currentPosition = PositionOf(rule);
        if (currentPosition < 1)
        {
            return;
        }

        DialogParameters<MoveRuleDialog> parameters = new();
        parameters.Add(component => component.CurrentPosition, currentPosition);
        parameters.Add(component => component.RuleCount, Rules.Count);

        IDialogReference dialog = await DialogService.ShowAsync<MoveRuleDialog>(
            "Move firewall rule",
            parameters,
            s_moveDialogOptions);
        int? targetPosition = await dialog.GetReturnValueAsync<int>();
        if (targetPosition is not null)
        {
            await MoveRequested.InvokeAsync(new RuleMoveRequest(rule.RuleId, targetPosition.Value));
        }
    }

    private int PositionOf(ListedFirewallRule rule)
    {
        for (int index = 0; index < Rules.Count; index++)
        {
            if (ReferenceEquals(Rules[index], rule))
            {
                return index + 1;
            }
        }

        return 0;
    }

    private static string BuildInsertBeforeHref(ListedFirewallRule rule)
        => BuildInsertHref("before", rule.RuleId);

    private static string BuildInsertAfterHref(ListedFirewallRule rule)
        => BuildInsertHref("after", rule.RuleId);

    private static string BuildInsertHref(string placement, string? ruleId)
        => string.IsNullOrWhiteSpace(ruleId)
            ? "/rules/create"
            : $"/rules/create?{placement}={Uri.EscapeDataString(ruleId)}";
}
