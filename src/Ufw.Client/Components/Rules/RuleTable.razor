<section aria-labelledby="firewall-rule-list-heading" class="rule-list-section">
    <h2 id="firewall-rule-list-heading" class="visually-hidden">Current firewall rules</h2>
    <MudPaper Elevation="0" Class="rule-table-card">
        <MudTable T="ListedFirewallRule"
                  Items="@Rules"
                  Loading="@Loading"
                  Hover="true"
                  Breakpoint="Breakpoint.Md"
                  Class="rule-table">
            <HeaderContent>
                <MudTh><span aria-hidden="true">#</span><span class="visually-hidden">Rule number</span></MudTh>
                <MudTh>Action</MudTh>
                <MudTh>Direction</MudTh>
                <MudTh>From</MudTh>
                <MudTh>To</MudTh>
                <MudTh>Protocol</MudTh>
                <MudTh>Comment</MudTh>
                <MudTh><span class="visually-hidden">Actions</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (context.Parsed && context.Rule is not null)
                {
                    <MudTd DataLabel="Rule number">
                        <span class="rule-number">@(context.DisplayNumber?.ToString() ?? "-")</span>
                    </MudTd>
                    <MudTd DataLabel="Action">
                        <span class="@FirewallRulePresentation.ActionClass(context.Rule.Action)">
                            @FirewallRulePresentation.FormatEnum(context.Rule.Action)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Direction">
                        <span class="rule-direction">@FirewallRulePresentation.FormatEnum(context.Rule.Direction)</span>
                        <span class="rule-family">@FirewallRulePresentation.FormatAddressFamily(context.Rule.AddressFamily)</span>
                    </MudTd>
                    <MudTd DataLabel="From">
                        <span class="rule-endpoint">
                            @FirewallRulePresentation.DescribeEndpoint(context.Rule.Source, null, context.Rule.SourceInterface)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="To">
                        <span class="rule-endpoint">
                            @FirewallRulePresentation.DescribeEndpoint(context.Rule.Destination, null, context.Rule.DestinationInterface)
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Protocol">
                        <span class="rule-protocol">@FirewallRulePresentation.FormatProtocol(context.Rule.Protocol)</span>
                        @if (FirewallRulePresentation.DescribePorts(context.Rule) is { } portDescription)
                        {
                            <span class="rule-protocol-detail">@portDescription</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Comment">
                        @if (!string.IsNullOrWhiteSpace(context.Rule.Comment))
                        {
                            <span class="rule-comment">@context.Rule.Comment</span>
                        }
                        else
                        {
                            <span class="rule-comment-empty">None</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="rule-row-actions">
                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
                                 Size="Size.Small"
                                 Dense="true"
                                 Class="rule-row-menu"
                                 aria-label="@ActionsLabel(context)">
                            <MudMenuItem Disabled="@(Disabled || string.IsNullOrWhiteSpace(context.RuleId))"
                                         OnClick="@(() => DeleteRequested.InvokeAsync(context))"
                                         Class="rule-menu-delete">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" />
                                Delete rule
                            </MudMenuItem>
                        </MudMenu>
                    </MudTd>
                }
                else
                {
                    <MudTd DataLabel="Rule number">
                        <span class="rule-number">@(context.DisplayNumber?.ToString() ?? "-")</span>
                    </MudTd>
                    <MudTd colspan="6">
                        <div class="rule-unsupported">
                            <span class="rule-unsupported-label">Read only</span>
                            <span class="rule-raw-line">@context.RawLine</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="rule-row-actions">
                        <MudTooltip Text="This UFW line could not be parsed safely and cannot be mutated through the API.">
                            <span role="img" aria-label="Rule is read-only because it could not be parsed safely">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                            </span>
                        </MudTooltip>
                    </MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <div class="rule-empty-state">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">No firewall rules</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        The authoritative UFW rule list is empty.
                    </MudText>
                    <MudButton Href="/rules/create"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@Disabled"
                               Class="mt-2">
                        Add rule
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</section>

@code {
    [Parameter]
    public IReadOnlyList<ListedFirewallRule> Rules { get; set; } = [];

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<ListedFirewallRule> DeleteRequested { get; set; }

    private static string ActionsLabel(ListedFirewallRule rule)
        => rule.DisplayNumber is { } number ? $"Actions for firewall rule {number}" : "Firewall rule actions";
}
