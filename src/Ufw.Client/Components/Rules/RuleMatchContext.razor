@using Ufw.Client.Rules.Filtering.Text
@inject IStringLocalizer<RulesStrings> RulesText

<div class="rule-match-context" role="note" aria-label="@(RulesText["RuleMatchContextAria"])" @onclick:stopPropagation="true">
    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" />
    <span class="rule-match-context-label">@RulesText["RuleMatchContextLabel"]</span>
    @foreach (RuleMatchEvidence evidence in Evidence)
    {
        <span class="rule-match-evidence-separator" aria-hidden="true">&middot;</span>
        @if (evidence is TextRuleMatchEvidence text)
        {
            RuleMatchTextSnippet snippet = DescribeTextMatch(text);
            <span class="rule-match-evidence rule-match-evidence-text">
                <span>@DescribeTextField(text.Field): </span>
                @if (snippet.HasLeadingEllipsis)
                {
                    <text>&hellip;</text>
                }
                @snippet.Prefix<mark>@snippet.Match</mark>@snippet.Suffix
                @if (snippet.HasTrailingEllipsis)
                {
                    <text>&hellip;</text>
                }
            </span>
        }
        else
        {
            <span class="rule-match-evidence">@DescribeEvidence(evidence)</span>
        }
    }
</div>
