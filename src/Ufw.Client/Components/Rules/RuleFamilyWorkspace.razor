@inject IDialogService DialogService
@inject IFirewallRuleText RuleText
@inject IStringLocalizer<RulesStrings> RulesText

<section aria-labelledby="firewall-rule-list-heading" class="rule-family-workspace">
    <h2 id="firewall-rule-list-heading" class="visually-hidden">@RulesText["CurrentAddressFamilyRules", RuleText.FormatAddressFamily(Family.AddressFamily)]</h2>
    <RuleListToolbar Query="@Query"
                     AddressFamily="@Family.AddressFamily"
                     Disabled="@QueryChangesDisabled"
                     QueryChanged="@QueryChanged" />
    <MudPaper Elevation="0" Class="surface">
        @if (Loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Class="progress"
                               aria-label="@(RulesText["LoadingStateAria"])" />
        }

        @if (DisplayedRows.Count == 0)
        {
            <div class="empty-state">
                @if (QueryActive && Family.Rows.Count > 0)
                {
                    <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@RulesText["NoMatchingRules"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["NoMatchingRulesDescription"]</MudText>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle1">@RulesText["NoAddressFamilyRules", RuleText.FormatAddressFamily(Family.AddressFamily)]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @RulesText["NoAddressFamilyRulesDescription", RuleText.FormatAddressFamily(Family.AddressFamily)]
                    </MudText>
                    <MudButton Href="/rules/create"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@Disabled"
                               Class="mt-2">
                        @RulesText["AddRule"]
                    </MudButton>
                }
            </div>
        }
        else
        {
            <div class="desktop-list" tabindex="0" role="region" aria-label="@(RulesText["FamilyTableAria", RuleText.FormatAddressFamily(Family.AddressFamily)])">
                <table aria-busy="@Loading">
                    <thead>
                        <tr>
                            <th scope="col" class="drag"><span class="visually-hidden">@RulesText["ReorderColumn"]</span></th>
                            <th scope="col" class="position">@RulesText["RulePositionColumn"]</th>
                            <th scope="col" class="action">@RulesText["ActionColumn"]</th>
                            <th scope="col" class="direction">@RulesText["DirectionColumn"]</th>
                            <th scope="col" class="endpoint">@RulesText["FromColumn"]</th>
                            <th scope="col" class="endpoint">@RulesText["ToColumn"]</th>
                            <th scope="col" class="protocol">@RulesText["ProtocolColumn"]</th>
                            <th scope="col" class="tags">@RulesText["TagsColumn"]</th>
                            <th scope="col" class="comment">@RulesText["CommentColumn"]</th>
                            <th scope="col" class="actions"><span class="visually-hidden">@RulesText["ActionsColumn"]</span></th>
                        </tr>
                    </thead>
                    @foreach (RuleQueryRow result in DisplayedRows)
                    {
                        RuleRowProjection row = result.Row;
                        <RuleDesktopRow @key="row.OccurrenceId"
                                        Row="@row"
                                        MatchEvidence="@result.Evidence"
                                        OrderingDisabled="@OrderingDisabled"
                                        InsertionDisabled="@InsertionDisabled"
                                        MutationDisabled="@Disabled"
                                        DropIndicatorEdge="@DropIndicatorEdge(row)"
                                        DragStarted="@BeginDrag"
                                        DragEntered="@SetDragTarget"
                                        DragEnded="@EndDrag"
                                        DropRequested="@DropAsync"
                                        MoveToPositionRequested="@RequestMoveToPositionAsync"
                                        InsertionRequested="@InsertionRequested"
                                        DeleteRequested="@DeleteRequested"
                                        MetadataEditDisabled="@MetadataEditDisabled"
                                        MetadataEditRequested="@MetadataEditRequested" />
                    }
                </table>
            </div>

            <div class="mobile-list" aria-busy="@Loading">
                @foreach (RuleQueryRow result in DisplayedRows)
                {
                    RuleRowProjection row = result.Row;
                    <RuleMobileCard @key="row.OccurrenceId"
                                    Row="@row"
                                    MatchEvidence="@result.Evidence"
                                    OrderingDisabled="@OrderingDisabled"
                                    InsertionDisabled="@InsertionDisabled"
                                    MutationDisabled="@Disabled"
                                    DropIndicatorEdge="@DropIndicatorEdge(row)"
                                    DragStarted="@BeginDrag"
                                    DragEntered="@SetDragTarget"
                                    DragEnded="@EndDrag"
                                    DropRequested="@DropAsync"
                                    MoveToPositionRequested="@RequestMoveToPositionAsync"
                                    InsertionRequested="@InsertionRequested"
                                    DeleteRequested="@DeleteRequested"
                                    MetadataEditDisabled="@MetadataEditDisabled"
                                    MetadataEditRequested="@MetadataEditRequested" />
                }
            </div>
        }
    </MudPaper>

    @if (Family.Rows.Count > 0)
    {
        <div class="ordering-note" role="note">
            @if (QueryActive)
            {
                <strong>@RulesText["FilteredRuleCount", DisplayedRows.Count, Family.Rows.Count]</strong>
                <span>@RulesText["FilteringDisablesOrdering"]</span>
            }
            else
            {
                <strong>@RulesText["OrderingLabel"]</strong>
                <span>@RulesText["OrderingDescription"]</span>
            }
        </div>
    }
</section>
