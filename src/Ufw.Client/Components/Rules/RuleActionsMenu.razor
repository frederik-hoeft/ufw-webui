@inject IStringLocalizer<RulesStrings> RulesText

<MudMenu Icon="@Icons.Material.Filled.MoreHoriz"
         Size="Size.Small"
         Dense="true"
         Class="rule-row-menu"
         PopoverClass="rule-row-menu-popover"
         aria-label="@ActionsLabel">
    <MudMenuItem Disabled="@(OrderingDisabled || !CanOrder)"
                 OnClick="@(() => MoveToPositionRequested.InvokeAsync(Rule))">
        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="rule-menu-icon" />
        @RulesText["MoveToPosition"]
    </MudMenuItem>
    <MudMenuItem Disabled="@(InsertionDisabled || !CanOrder)"
                 Href="@BuildInsertHref("before")">
        <MudIcon Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" Class="rule-menu-icon" />
        @RulesText["InsertBefore"]
    </MudMenuItem>
    <MudMenuItem Disabled="@(InsertionDisabled || !CanOrder)"
                 Href="@BuildInsertHref("after")">
        <MudIcon Icon="@Icons.Material.Filled.VerticalAlignBottom" Size="Size.Small" Class="rule-menu-icon" />
        @RulesText["InsertAfter"]
    </MudMenuItem>
    <MudDivider />
    <MudMenuItem Disabled="@(MutationDisabled || !CanMutate)"
                 OnClick="@(() => DeleteRequested.InvokeAsync(Rule))"
                 Class="rule-menu-delete">
        <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="rule-menu-icon" />
        @RulesText["DeleteRule"]
    </MudMenuItem>
</MudMenu>

@code {
    [Parameter, EditorRequired]
    public ListedFirewallRule Rule { get; set; } = null!;

    [Parameter]
    public bool OrderingDisabled { get; set; }

    [Parameter]
    public bool InsertionDisabled { get; set; }

    [Parameter]
    public bool MutationDisabled { get; set; }

    [Parameter]
    public bool CanOrder { get; set; }

    [Parameter]
    public bool CanMutate { get; set; }

    [Parameter]
    public EventCallback<ListedFirewallRule> MoveToPositionRequested { get; set; }

    [Parameter]
    public EventCallback<ListedFirewallRule> DeleteRequested { get; set; }

    private string ActionsLabel => Rule.DisplayNumber is { } number
        ? RulesText["ActionsForRule", number.ToString(System.Globalization.CultureInfo.CurrentCulture)]
        : RulesText["RuleActions"];

    private string BuildInsertHref(string placement)
        => string.IsNullOrWhiteSpace(Rule.RuleId)
            ? "/rules/create"
            : $"/rules/create?{placement}={Uri.EscapeDataString(Rule.RuleId)}";
}
