@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@RulesText["CleanupOrphanedMetadataConfirmation", Count]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            @RulesText["CleanupOrphanedMetadataDescription"]
        </MudText>
    </DialogContent>
    <DialogActions>
        <div class="delete-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="Cancel">@CommonText["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">
                @RulesText["CleanupSelectedMetadata"]
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
