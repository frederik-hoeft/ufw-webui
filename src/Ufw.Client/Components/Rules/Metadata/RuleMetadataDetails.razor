@using Ufw.Client.Rules.Metadata
@inject IStringLocalizer<RulesStrings> RulesText

<section class="rule-metadata-details" aria-label="@(RulesText["RuleMetadataAria"])">
    <header>
        <div>
            <span class="rule-metadata-title">@RulesText["RuleMetadata"]</span>
            <span class="rule-metadata-description">@RulesText["RuleMetadataDescription"]</span>
        </div>
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@EditDisabled"
                   OnClick="@EditRequested">
            @RulesText["EditMetadata"]
        </MudButton>
    </header>

    @if (Metadata is null)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["NoRuleMetadata"]</MudText>
    }
    else
    {
        <div class="rule-metadata-fields">
            <div>
                <span class="rule-metadata-field-label">@RulesText["Tags"]</span>
                @if (Metadata.Tags.Count == 0)
                {
                    <span class="rule-metadata-empty">@RulesText["None"]</span>
                }
                else
                {
                    <RuleTagList Tags="@Metadata.Tags" />
                }
            </div>
            <div>
                <span class="rule-metadata-field-label">@RulesText["Notes"]</span>
                @if (string.IsNullOrWhiteSpace(Metadata.Notes))
                {
                    <span class="rule-metadata-empty">@RulesText["None"]</span>
                }
                else
                {
                    <span class="rule-metadata-notes">@Metadata.Notes</span>
                }
            </div>
        </div>
    }
</section>
