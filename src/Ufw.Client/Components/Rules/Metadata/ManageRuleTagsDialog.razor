@using Ufw.Client.Rules.Metadata
@inject IRuleTagCatalogService TagCatalog
@inject IRuleTagColorGenerator TagColors
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <div class="rule-tag-manager-header">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["ManageTagsDescription"]</MudText>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="@IsBusy"
                       OnClick="BeginCreate">
                @RulesText["CreateTag"]
            </MudButton>
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4" role="alert">
                @_error.Message
            </MudAlert>
        }

        @if (_editing)
        {
            <section class="rule-tag-editor mt-4" aria-label="@(RulesText["TagEditorAria"])">
                <MudText Typo="Typo.subtitle2">@(_editingTag is null ? RulesText["CreateTag"] : RulesText["EditTag"])</MudText>
                <MudTextField T="string"
                              Label="@(RulesText["TagName"])"
                              @bind-Value="_name"
                              Immediate="true"
                              Required="true"
                              Counter="@MAX_TAG_NAME_LENGTH"
                              MaxLength="@MAX_TAG_NAME_LENGTH"
                              Disabled="@_saving"
                              autofocus="true"
                              Class="mt-3" />
                <div class="rule-tag-color-editor mt-3">
                    <span class="rule-metadata-field-label">@RulesText["TagColor"]</span>
                    <span class="rule-tag-color-preview" style="background-color: @_color" aria-hidden="true"></span>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   Disabled="@_saving"
                                   OnClick="ReshuffleColor"
                                   aria-label="@RulesText["ReshuffleTagColor"]" />
                </div>
                <footer>
                    <MudButton Variant="Variant.Text" Disabled="@_saving" OnClick="CancelEdit">@CommonText["Cancel"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="SaveTagAsync">
                        @(_saving ? RulesText["SavingTag"] : RulesText["SaveTag"])
                    </MudButton>
                </footer>
            </section>
        }

        @if (_loading && _tags.Count == 0)
        {
            <div class="rule-tag-manager-loading mt-4" role="status" aria-live="polite">
                <MudProgressLinear Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["LoadingTags"]</MudText>
            </div>
        }
        else if (!_loading && _tags.Count == 0)
        {
            <div class="rule-tag-manager-empty mt-4">
                <MudIcon Icon="@Icons.Material.Outlined.Label" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["NoTagsDefined"]</MudText>
            </div>
        }
        else
        {
            <div class="rule-tag-manager-list mt-4">
                @foreach (RuleTag tag in _tags)
                {
                    <div class="rule-tag-manager-row">
                        <RuleTagChip Tag="@tag" />
                        <div class="rule-tag-manager-actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => BeginEdit(tag))"
                                           aria-label="@RulesText["EditTagAria", tag.Name]" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="@IsBusy"
                                           OnClick="@(() => DeleteTagAsync(tag))"
                                           aria-label="@RulesText["DeleteTagAria", tag.Name]" />
                        </div>
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@IsBusy" OnClick="Close">@RulesText["Close"]</MudButton>
    </DialogActions>
</MudDialog>
