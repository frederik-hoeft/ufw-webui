@using Ufw.Client.Rules.Metadata
@inject IRuleMetadataReconciliationService Reconciliation
@inject IClientErrorMapper ClientErrors
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <div class="rule-metadata-reconciliation-header">
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["ReconcileMetadataDescription"]</MudText>
                @if (!_loading && _snapshot is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        @DescribeOrphanCount(_snapshot.Orphans.Count)
                    </MudText>
                }
            </div>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@IsBusy"
                       OnClick="RefreshAsync">
                @CommonText["Refresh"]
            </MudButton>
        </div>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4" role="alert">
                @_error.Message
            </MudAlert>
        }

        @if (_loading && _snapshot is null)
        {
            <div class="rule-metadata-reconciliation-empty mt-4" role="status" aria-live="polite">
                <MudProgressLinear Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["LoadingMetadataReconciliation"]</MudText>
            </div>
        }
        else if (_snapshot is { Orphans.Count: 0 })
        {
            <div class="rule-metadata-reconciliation-empty mt-4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
                <MudText Typo="Typo.subtitle2">@RulesText["NoOrphanedMetadata"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["NoOrphanedMetadataDescription"]</MudText>
            </div>
        }
        else if (_snapshot is { } snapshot)
        {
            <div class="rule-metadata-reconciliation-actions mt-4">
                <MudButton Variant="Variant.Text" Disabled="@IsBusy" OnClick="SelectAll">
                    @RulesText["SelectAll"]
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="@(IsBusy || _selected.Count == 0)" OnClick="ClearSelection">
                    @RulesText["ClearSelection"]
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @RulesText["SelectedMetadataCount", _selected.Count]
                </MudText>
            </div>

            <div class="rule-metadata-reconciliation-list mt-2">
                @foreach (OrphanedRuleMetadata orphan in snapshot.Orphans)
                {
                    <article class="rule-metadata-reconciliation-row">
                        <MudCheckBox T="bool"
                                     Value="@_selected.Contains(orphan.Metadata.Id)"
                                     ValueChanged="@(value => SelectionChanged(orphan.Metadata.Id, value))"
                                     Disabled="@IsBusy"
                                     aria-label="@RulesText["SelectOrphanedMetadata", DescribeRuleId(orphan.RuleId)]" />
                        <div class="rule-metadata-reconciliation-content">
                            <header>
                                <MudText Typo="Typo.subtitle2">@RulesText["OrphanedMetadata"]</MudText>
                                <code title="@orphan.RuleId">@DescribeRuleId(orphan.RuleId)</code>
                            </header>
                            @if (orphan.Metadata.Tags.Count > 0)
                            {
                                <RuleTagList Tags="@orphan.Metadata.Tags" />
                            }
                            @if (!string.IsNullOrWhiteSpace(orphan.Metadata.Notes))
                            {
                                <MudText Typo="Typo.body2" Class="rule-metadata-reconciliation-notes">@orphan.Metadata.Notes</MudText>
                            }
                            else if (orphan.Metadata.Tags.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@RulesText["OrphanedMetadataNoContext"]</MudText>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="@IsBusy" OnClick="Close">@RulesText["Close"]</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Disabled="@(IsBusy || _selected.Count == 0)"
                   OnClick="CleanupAsync">
            @(_cleaning ? RulesText["CleaningMetadata"] : RulesText["CleanupSelectedMetadata"])
        </MudButton>
    </DialogActions>
</MudDialog>
