<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5">
    <MudText Typo="Typo.subtitle1" GutterBottom="true">Confirm rule deletion</MudText>
    <MudText Typo="Typo.body2" Class="mb-1">@FirewallRulePresentation.DescribeRule(Rule)</MudText>
    @if (!string.IsNullOrWhiteSpace(Rule.RuleId))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="rule-raw-line mb-3">Rule ID: @Rule.RuleId</MudText>
    }
    <MudTextField T="string"
                  Label="ECDSA P-256 private key (PKCS#8)"
                  InputType="InputType.Password"
                  Value="@PrivateKey"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  ValueChanged="PrivateKeyChangedAsync"
                  Disabled="@Disabled"
                  HelperText="Used only to sign this delete request. The key is not stored by the client."
                  Immediate="true"
                  Class="mb-3" />
    <MudButton Variant="Variant.Filled"
               Color="Color.Error"
               Disabled="@(Disabled || string.IsNullOrWhiteSpace(PrivateKey))"
               OnClick="OnConfirm"
               Class="mr-2">
        Delete signed rule
    </MudButton>
    <MudButton Variant="Variant.Text" Disabled="@Disabled" OnClick="OnCancel">Cancel</MudButton>
</MudAlert>

@code {
    [Parameter, EditorRequired]
    public ListedFirewallRule Rule { get; set; } = null!;

    [Parameter]
    public string PrivateKey { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> PrivateKeyChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task PrivateKeyChangedAsync(string? value)
    {
        PrivateKey = value ?? string.Empty;
        await PrivateKeyChanged.InvokeAsync(PrivateKey);
    }
}
