@inject IFirewallRuleText RuleText
@inject IStringLocalizer<RulesStrings> RulesText

@{
    ListedFirewallRule rule = Row.Rule;
}

@if (rule.Parsed && rule.Rule is not null)
{
    <tr class="@RowClass"
        @ondragenter="@DragEnterHandler"
        @ondragover:preventDefault
        @ondrop="DropAsync">
        <td class="rule-drag-column">
            <button type="button"
                    class="@DragHandleClass"
                    draggable="@DragEnabled"
                    disabled="@(OrderingDisabled || !Row.CanOrder)"
                    title="@DragHandleTitle"
                    aria-label="@DragHandleLabel"
                    @ondragstart="@BeginDragHandler"
                    @ondragend="@EndDragHandler">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
            </button>
        </td>
        <td class="rule-number-column">
            @if (Row.PositionChange is { } positionChange)
            {
                <span class="@PositionChangeClass(positionChange.DirectlyMoved)"
                      aria-label="@PositionChangeLabel(positionChange.OriginalPosition, positionChange.CurrentPosition, positionChange.DirectlyMoved)">
                    <span aria-hidden="true" class="rule-position-change-values">
                        @if (positionChange.DirectlyMoved)
                        {
                            <s>@positionChange.OriginalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</s>
                        }
                        else
                        {
                            <span>@positionChange.OriginalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                        }
                        <span class="rule-position-arrow">&rarr;</span>
                        <span>@positionChange.CurrentPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                    </span>
                </span>
            }
            else
            {
                <span class="rule-number">@Row.FamilyPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
            }
        </td>
        <td class="rule-action-column">
            <span class="@ActionClass(rule.Rule.Action)">
                @RuleText.FormatAction(rule.Rule.Action)
            </span>
        </td>
        <td class="rule-direction-column">
            <span class="rule-direction">@RuleText.FormatDirection(rule.Rule.Direction)</span>
        </td>
        <td class="rule-endpoint-column">
            <span class="rule-endpoint">
                @RuleText.DescribeEndpoint(rule.Rule.Source, rule.Rule.SourcePorts, rule.Rule.SourceInterface)
            </span>
        </td>
        <td class="rule-endpoint-column">
            <span class="rule-endpoint">
                @RuleText.DescribeEndpoint(rule.Rule.Destination, rule.Rule.DestinationPorts, rule.Rule.DestinationInterface)
            </span>
        </td>
        <td class="rule-protocol-column">
            <span class="rule-protocol">@RuleText.FormatProtocol(rule.Rule.Protocol)</span>
        </td>
        <td class="rule-comment-column">
            @if (!string.IsNullOrWhiteSpace(rule.Rule.Comment))
            {
                <span class="rule-comment">@rule.Rule.Comment</span>
            }
            else
            {
                <span class="rule-comment-empty">@RulesText["None"]</span>
            }
        </td>
        <td class="rule-row-actions">
            <RuleActionsMenu Rule="@rule"
                             FamilyPosition="@Row.FamilyPosition"
                             OrderingDisabled="@OrderingDisabled"
                             InsertionDisabled="@InsertionDisabled"
                             MutationDisabled="@MutationDisabled"
                             CanOrder="@Row.CanOrder"
                             CanMutate="@Row.CanMutate"
                             MoveToPositionRequested="@(() => MoveToPositionRequested.InvokeAsync(Row))"
                             InsertionRequested="@InsertionRequested"
                             DeleteRequested="@DeleteRequested" />
        </td>
    </tr>
}
else
{
    <tr class="@ReadOnlyRowClass"
        @ondragenter="@DragEnterHandler"
        @ondragover:preventDefault
        @ondrop="DropAsync">
        <td class="rule-drag-column">
            <span class="rule-drag-handle rule-drag-handle-disabled" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
            </span>
        </td>
        <td class="rule-number-column">
            @if (Row.PositionChange is { } positionChange)
            {
                <span class="@PositionChangeClass(positionChange.DirectlyMoved)"
                      aria-label="@PositionChangeLabel(positionChange.OriginalPosition, positionChange.CurrentPosition, positionChange.DirectlyMoved)">
                    <span aria-hidden="true" class="rule-position-change-values">
                        <span>@positionChange.OriginalPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                        <span class="rule-position-arrow">&rarr;</span>
                        <span>@positionChange.CurrentPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
                    </span>
                </span>
            }
            else
            {
                <span class="rule-number">@Row.FamilyPosition.ToString(System.Globalization.CultureInfo.CurrentCulture)</span>
            }
        </td>
        <td colspan="6">
            <div class="rule-unsupported">
                <span class="rule-unsupported-label">@RulesText["ReadOnly"]</span>
                <span class="rule-raw-line">@rule.RawLine</span>
            </div>
        </td>
        <td class="rule-row-actions">
            <MudTooltip Text="@(RulesText["ReadOnlyTooltip"])">
                <span role="img" aria-label="@(RulesText["ReadOnlyAria"])">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                </span>
            </MudTooltip>
        </td>
    </tr>
}
