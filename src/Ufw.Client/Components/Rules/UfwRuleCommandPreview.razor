@inject IUfwRuleCommandRenderer UfwRuleCommandRenderer
@inject IStringLocalizer<RulesStrings> RulesText

<div class="ufw-command-preview" role="group" aria-label="@EffectiveLabel">
    <MudText Typo="Typo.overline" HtmlTag="div" Class="ufw-command-preview-label">@EffectiveLabel</MudText>
    @if (TryGetCommandText(out string? commandText))
    {
        <code class="ufw-command-preview-value">@commandText</code>
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ufw-command-preview-empty">
            @RulesText["CommandPreviewEmpty"]
        </MudText>
    }
    @if (Details is not null)
    {
        <div class="ufw-command-preview-details">
            @Details
        </div>
    }
</div>
