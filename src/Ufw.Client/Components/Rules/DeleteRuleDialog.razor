@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">@FirewallRulePresentation.DescribeRule(Rule)</MudText>
        @if (!string.IsNullOrWhiteSpace(Rule.RuleId))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="rule-raw-line mb-4">
                Rule ID: @Rule.RuleId
            </MudText>
        }

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            Deleting this firewall rule requires a signed authorization and cannot be undone through this interface.
        </MudAlert>

        <MudForm @ref="_form" @bind-IsValid="_isValid" OnEnterPressed="ConfirmAsync">
            <MudTextField T="string"
                          Label="ECDSA P-256 private key (PKCS#8)"
                          InputType="InputType.Password"
                          @bind-Value="_privateKey"
                          autocomplete="off"
                          autocapitalize="off"
                          spellcheck="false"
                          Required="true"
                          RequiredError="A private key is required to authorize this mutation."
                          HelperText="Used only to sign this delete request. The key is not stored by the client."
                          Placeholder="PKCS#8 PEM or base64 DER"
                          Immediate="true" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <div class="delete-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(!_isValid || string.IsNullOrWhiteSpace(_privateKey))"
                       OnClick="ConfirmAsync">
                Delete signed rule
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private MudForm? _form;
    private bool _isValid;
    private string _privateKey = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public ListedFirewallRule Rule { get; set; } = null!;

    public void Dispose() => _privateKey = string.Empty;

    private void Cancel()
    {
        _privateKey = string.Empty;
        MudDialog.Cancel();
    }

    private async Task ConfirmAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid || string.IsNullOrWhiteSpace(_privateKey))
        {
            return;
        }

        string privateKey = _privateKey;
        _privateKey = string.Empty;
        MudDialog.Close(DialogResult.Ok(privateKey));
    }
}
