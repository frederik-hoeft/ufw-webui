@implements IDisposable
@inject IStringLocalizer<CommonStrings> CommonText
@inject IStringLocalizer<RulesStrings> RulesText

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @RulesText["DeleteReview"]
        </MudText>

        @if (Rule.Rule is not null)
        {
            <UfwRuleCommandPreview Rule="@Rule.Rule" Label="@(RulesText["RuleToDelete"])">
                <Details>
                    @if (!string.IsNullOrWhiteSpace(Rule.RuleId))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="rule-raw-line">
                            @RulesText["RuleId", Rule.RuleId]
                        </MudText>
                    }
                </Details>
            </UfwRuleCommandPreview>
        }
        else
        {
            <div class="delete-rule-summary" aria-label="@(RulesText["RuleToDelete"])">
                <MudText Typo="Typo.overline" HtmlTag="div" Class="delete-rule-summary-label">@RulesText["RuleToDelete"]</MudText>
                <MudText Typo="Typo.body2" Class="delete-rule-summary-value">@Rule.RawLine</MudText>
            </div>
        }
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            @RulesText["DeleteWarning"]
        </MudAlert>

        <MudForm @ref="_form"
                 @bind-IsValid="_isValid"
                 Disabled="_busy"
                 OnEnterPressed="ConfirmAsync"
                 aria-busy="@_busy">
            <MutationAuthorizationField @bind-Value="_privateKey" Disabled="_busy" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <div class="delete-dialog-actions">
            <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="Cancel">@CommonText["Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(_busy || !_isValid || string.IsNullOrWhiteSpace(_privateKey))"
                       OnClick="ConfirmAsync">
                @RulesText["DeleteSignedRule"]
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
