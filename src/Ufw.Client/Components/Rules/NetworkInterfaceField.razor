@using System.Linq.Expressions
@inject IStringLocalizer<RulesStrings> RulesText

<div class="@CssClass">
    <label class="network-interface-label" for="@_inputId">@Label</label>
    <MudAutocomplete T="string"
                     InputId="@_inputId"
                     Value="@Value"
                     ValueChanged="ValueChanged"
                     For="@For"
                     SearchFunc="SearchAsync"
                     CoerceValue="true"
                     Clearable="@Clearable"
                     Immediate="true"
                     ResetValueOnEmptyText="true"
                     Disabled="@Disabled"
                     MaxItems="12"
                     autocomplete="off"
                     autocapitalize="off"
                     spellcheck="false">
        <NoItemsTemplate>
            <div class="network-interface-no-items">
                @RulesText["NoInterfaceMatches"]
            </div>
        </NoItemsTemplate>
    </MudAutocomplete>

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div class="network-interface-help">@HelperText</div>
    }
</div>

@code {
    private readonly string _inputId = $"network-interface-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? For { get; set; }

    [Parameter]
    public IReadOnlyList<string> Suggestions { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Clearable { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => string.IsNullOrWhiteSpace(Class)
        ? "network-interface-field"
        : $"network-interface-field {Class}";

    private Task<IEnumerable<string>> SearchAsync(string? value, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        IEnumerable<string> matches = string.IsNullOrWhiteSpace(value)
            ? Suggestions
            : Suggestions.Where(candidate => candidate.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(matches);
    }
}
