@using System.Linq.Expressions
@inject IStringLocalizer<RulesStrings> RulesText

<div class="@CssClass">
    <label class="network-interface-label" for="@_inputId">@Label</label>
    <MudAutocomplete T="string"
                     InputId="@_inputId"
                     Value="@Value"
                     ValueChanged="ValueChanged"
                     For="@For"
                     SearchFunc="SearchAsync"
                     CoerceValue="true"
                     Immediate="true"
                     ResetValueOnEmptyText="true"
                     Disabled="@Disabled"
                     MaxItems="@((int?)null)"
                     PopoverClass="network-interface-popover"
                     autocomplete="off"
                     autocapitalize="off"
                     spellcheck="false">
        <ItemTemplate Context="interfaceName">
            @if (FindSuggestion(interfaceName) is { } suggestion)
            {
                <div class="network-interface-option">
                    <code>@suggestion.Name</code>
                    @if (!string.IsNullOrWhiteSpace(suggestion.Comment))
                    {
                        <span>@suggestion.Comment</span>
                    }
                </div>
            }
            else
            {
                <code>@interfaceName</code>
            }
        </ItemTemplate>
        <NoItemsTemplate>
            <div class="network-interface-no-items">
                @RulesText["NoInterfaceMatches"]
            </div>
        </NoItemsTemplate>
    </MudAutocomplete>

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div class="network-interface-help">@HelperText</div>
    }

</div>
